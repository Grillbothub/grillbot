{% doc %}
  @prompt
    i want to make carousal for multiple videos (n number of videos)  , i want to upload my custom videos and make it per slide 5 to show , add pagination dots
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-video-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-video-carousel__title-{{ ai_gen_id }} {
    font-size: 32px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .ai-video-carousel__subtitle-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-video-carousel__slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__slider-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    min-width: 100%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.video_gap }}px;
    padding: 0 10px;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
    color: #666;
    font-size: 16px;
    text-align: center;
    padding: 20px;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    transform: scale(1.1);
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }}:disabled:hover {
    transform: scale(1);
  }

  .ai-video-carousel__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-video-carousel__pagination-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.3);
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 1200px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.video_gap | divided_by: 2 }}px;
    }

    .ai-video-carousel__title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-video-carousel__arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-video-carousel__arrow-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-video-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-video-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-video-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign videos = ''
      assign video_count = 0

      for i in (1..20)
        assign video_key = 'video_' | append: i
        assign video = block.settings[video_key]
        if video != blank
          assign video_count = video_count | plus: 1
          if videos == ''
            assign videos = video
          else
            assign videos = videos | append: '|||' | append: video
          endif
        endif
      endfor

      assign videos_per_slide = 5
      assign total_slides = video_count | divided_by: videos_per_slide
      assign remainder = video_count | modulo: videos_per_slide
      if remainder > 0
        assign total_slides = total_slides | plus: 1
      endif
    %}

    {% if video_count > 0 %}
      <div class="ai-video-carousel__slider-wrapper-{{ ai_gen_id }}">
        <div class="ai-video-carousel__slider-{{ ai_gen_id }}" data-slider>
          {% assign video_array = videos | split: '|||' %}
          {% assign slide_index = 0 %}
          {% assign video_index = 0 %}

          {% for slide_num in (1..total_slides) %}
            <div class="ai-video-carousel__slide-{{ ai_gen_id }}" data-slide="{{ slide_num }}">
              {% for i in (1..videos_per_slide) %}
                {% if video_index < video_count %}
                  {% assign current_video = video_array[video_index] %}
                  <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                    <video
                      class="ai-video-carousel__video-{{ ai_gen_id }}"
                      {% if block.settings.autoplay %}autoplay{% endif %}
                      {% if block.settings.loop %}loop{% endif %}
                      {% if block.settings.muted %}muted{% endif %}
                      {% if block.settings.controls %}controls{% endif %}
                      playsinline
                    >
                      <source src="{{ current_video }}" type="video/mp4">
                    </video>
                  </div>
                  {% assign video_index = video_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if total_slides > 1 %}
        <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
          <button
            class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow--prev-{{ ai_gen_id }}"
            aria-label="Previous slide"
            data-prev
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="ai-video-carousel__pagination-{{ ai_gen_id }}" data-pagination>
            {% for i in (1..total_slides) %}
              <button
                class="ai-video-carousel__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
                aria-label="Go to slide {{ i }}"
                data-dot="{{ i }}"
              ></button>
            {% endfor %}
          </div>

          <button
            class="ai-video-carousel__arrow-{{ ai_gen_id }} ai-video-carousel__arrow--next-{{ ai_gen_id }}"
            aria-label="Next slide"
            data-next
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
        <p>Add videos to display in the carousel</p>
      </div>
    {% endif %}
  </div>
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 0;
      }

      connectedCallback() {
        this.slider = this.querySelector('[data-slider]');
        this.slides = this.querySelectorAll('[data-slide]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.pagination = this.querySelector('[data-pagination]');
        this.dots = this.querySelectorAll('[data-dot]');

        if (!this.slider || this.slides.length === 0) return;

        this.totalSlides = this.slides.length;
        this.setupEventListeners();
        this.updateCarousel();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.getAttribute('data-dot')) - 1;
            this.goToSlide(slideIndex);
          });
        });

        let startX = 0;
        let endX = 0;

        this.slider.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.slider.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;
          if (startX - endX > 50) {
            this.goToNextSlide();
          } else if (endX - startX > 50) {
            this.goToPrevSlide();
          }
        });
      }

      goToSlide(index) {
        if (index < 0 || index >= this.totalSlides) return;
        this.currentSlide = index;
        this.updateCarousel();
      }

      goToPrevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateCarousel();
        }
      }

      goToNextSlide() {
        if (this.currentSlide < this.totalSlides - 1) {
          this.currentSlide++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        const offset = -this.currentSlide * 100;
        this.slider.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;
        }
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

