{% doc %}
  @prompt
    create masonary elements with image review text like star title and desciption. make it per row 4
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-masonry-reviews-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-masonry-reviews__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-masonry-reviews__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-masonry-reviews__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
    grid-auto-rows: 10px;
  }

  .ai-masonry-reviews__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-masonry-reviews__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-masonry-reviews__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-masonry-reviews__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-masonry-reviews__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-masonry-reviews__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-masonry-reviews__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-masonry-reviews__star-{{ ai_gen_id }}--empty {
    fill: {{ block.settings.empty_star_color }};
  }

  .ai-masonry-reviews__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-masonry-reviews__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 1200px) {
    .ai-masonry-reviews__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 900px) {
    .ai-masonry-reviews__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .ai-masonry-reviews__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<masonry-reviews-{{ ai_gen_id }}
  class="ai-masonry-reviews-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-masonry-reviews__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-masonry-reviews__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-masonry-reviews__grid-{{ ai_gen_id }}" data-masonry-grid>
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'review_' | append: i | append: '_image'
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign title_key = 'review_' | append: i | append: '_title'
          assign description_key = 'review_' | append: i | append: '_description'

          assign review_image = block.settings[image_key]
          assign review_rating = block.settings[rating_key]
          assign review_title = block.settings[title_key]
          assign review_description = block.settings[description_key]
        %}

        {% if review_title != blank or review_description != blank %}
          <div class="ai-masonry-reviews__item-{{ ai_gen_id }}" data-masonry-item>
            {% if review_image != blank %}
              <div class="ai-masonry-reviews__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ review_image | image_url: width: 600 }}"
                  alt="{{ review_image.alt | escape }}"
                  loading="lazy"
                  width="{{ review_image.width }}"
                  height="{{ review_image.height }}"
                  class="ai-masonry-reviews__image-{{ ai_gen_id }}"
                >
              </div>
            {% endif %}

            <div class="ai-masonry-reviews__stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                {% if star <= review_rating %}
                  <svg
                    class="ai-masonry-reviews__star-{{ ai_gen_id }}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                {% else %}
                  <svg
                    class="ai-masonry-reviews__star-{{ ai_gen_id }} ai-masonry-reviews__star-{{ ai_gen_id }}--empty"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                {% endif %}
              {% endfor %}
            </div>

            {% if review_title != blank %}
              <h3 class="ai-masonry-reviews__title-{{ ai_gen_id }}">{{ review_title }}</h3>
            {% endif %}

            {% if review_description != blank %}
              <p class="ai-masonry-reviews__description-{{ ai_gen_id }}">{{ review_description }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</masonry-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class MasonryReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.grid = null;
        this.items = [];
      }

      connectedCallback() {
        this.grid = this.querySelector('[data-masonry-grid]');
        this.items = Array.from(this.querySelectorAll('[data-masonry-item]'));
        
        if (this.grid && this.items.length > 0) {
          this.initMasonry();
          window.addEventListener('resize', this.handleResize.bind(this));
        }
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize.bind(this));
      }

      initMasonry() {
        if (window.innerWidth <= 600) {
          this.items.forEach(item => {
            item.style.gridRowEnd = 'auto';
          });
          return;
        }

        this.items.forEach(item => {
          const height = item.getBoundingClientRect().height;
          const rowSpan = Math.ceil(height / 10);
          item.style.gridRowEnd = 'span ' + rowSpan;
        });
      }

      handleResize() {
        this.initMasonry();
      }
    }

    customElements.define('masonry-reviews-{{ ai_gen_id }}', MasonryReviews{{ ai_gen_id }});
  })();
</script>

