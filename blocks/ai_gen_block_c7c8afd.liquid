{% doc %}
  @prompt
    i want to make carousal for multiple videos (n number of videos)  , i want to upload my custom videos and make it per row 5 to show , add pagination dots
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-grid-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-video-grid__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-video-grid__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
  }

  .ai-video-grid__description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
  }

  .ai-video-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-video-grid__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-video-grid__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background-color: #000000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
  }

  .ai-video-grid__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-grid__play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
    opacity: 0.9;
  }

  .ai-video-grid__play-button-{{ ai_gen_id }}:hover {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-grid__play-button-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-video-grid__play-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    fill: {{ block.settings.play_icon_color }};
    margin-left: 3px;
  }

  .ai-video-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    color: #666;
    font-size: 12px;
    text-align: center;
    padding: 10px;
  }

  .ai-video-grid__placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    margin-bottom: 10px;
    opacity: 0.5;
  }

  .ai-video-grid__pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.dot_spacing }}px;
    margin-top: 30px;
  }

  .ai-video-grid__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    opacity: 0.3;
  }

  .ai-video-grid__dot-{{ ai_gen_id }}:hover {
    opacity: 0.6;
  }

  .ai-video-grid__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-video-grid__modal-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-video-grid__modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-video-grid__modal-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
  }

  .ai-video-grid__modal-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-grid__modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 10px;
    font-size: 24px;
    line-height: 1;
  }

  .ai-video-grid__modal-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 1200px) {
    .ai-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media screen and (max-width: 989px) {
    .ai-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-video-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-video-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-video-grid__modal-content-{{ ai_gen_id }} {
      aspect-ratio: 16 / 9;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(1, 1fr);
    }
  }
{% endstyle %}

<video-grid-{{ ai_gen_id }}
  class="ai-video-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-grid__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-video-grid__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-video-grid__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-grid__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..20) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign video = block.settings[video_key]
        %}

        {% if video != blank %}
          <div class="ai-video-grid__item-{{ ai_gen_id }}" data-video-index="{{ forloop.index0 }}">
            <div class="ai-video-grid__video-wrapper-{{ ai_gen_id }}">
              <video
                class="ai-video-grid__video-{{ ai_gen_id }}"
                muted
                playsinline
                preload="metadata"
                data-video-src="{{ video }}"
              >
                <source src="{{ video }}" type="video/mp4">
              </video>
              <button
                class="ai-video-grid__play-button-{{ ai_gen_id }}"
                aria-label="Play video"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_pagination %}
      <div class="ai-video-grid__pagination-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  <div class="ai-video-grid__modal-{{ ai_gen_id }}">
    <div class="ai-video-grid__modal-content-{{ ai_gen_id }}">
      <button
        class="ai-video-grid__modal-close-{{ ai_gen_id }}"
        aria-label="Close video"
      >
        ✕
      </button>
      <video
        class="ai-video-grid__modal-video-{{ ai_gen_id }}"
        controls
        playsinline
      >
      </video>
    </div>
  </div>
</video-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGrid{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.itemsPerPage = 5;
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-video-grid__item-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-video-grid__modal-{{ ai_gen_id }}');
        this.modalVideo = this.querySelector('.ai-video-grid__modal-video-{{ ai_gen_id }}');
        this.modalClose = this.querySelector('.ai-video-grid__modal-close-{{ ai_gen_id }}');
        this.pagination = this.querySelector('.ai-video-grid__pagination-{{ ai_gen_id }}');

        this.updateItemsPerPage();
        this.setupEventListeners();
        this.createPagination();
        this.updateActiveDot();
      }

      updateItemsPerPage() {
        const width = window.innerWidth;
        if (width <= 480) {
          this.itemsPerPage = 1;
        } else if (width <= 749) {
          this.itemsPerPage = 2;
        } else if (width <= 989) {
          this.itemsPerPage = 3;
        } else if (width <= 1200) {
          this.itemsPerPage = 4;
        } else {
          this.itemsPerPage = 5;
        }
      }

      createPagination() {
        if (!this.pagination) return;

        this.pagination.innerHTML = '';
        const totalPages = Math.ceil(this.items.length / this.itemsPerPage);

        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-video-grid__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
          dot.dataset.page = i;
          
          dot.addEventListener('click', () => {
            this.scrollToPage(i);
          });

          this.pagination.appendChild(dot);
        }
      }

      scrollToPage(pageIndex) {
        const firstItemIndex = pageIndex * this.itemsPerPage;
        const targetItem = this.items[firstItemIndex];
        
        if (targetItem) {
          targetItem.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          this.currentPage = pageIndex;
          this.updateActiveDot();
        }
      }

      updateActiveDot() {
        if (!this.pagination) return;

        const dots = this.pagination.querySelectorAll('.ai-video-grid__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentPage) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const video = item.querySelector('.ai-video-grid__video-{{ ai_gen_id }}');
          const playButton = item.querySelector('.ai-video-grid__play-button-{{ ai_gen_id }}');
          const wrapper = item.querySelector('.ai-video-grid__video-wrapper-{{ ai_gen_id }}');

          wrapper.addEventListener('mouseenter', () => {
            if (video && video.paused) {
              video.play().catch(() => {});
            }
          });

          wrapper.addEventListener('mouseleave', () => {
            if (video && !video.paused) {
              video.pause();
              video.currentTime = 0;
            }
          });

          playButton.addEventListener('click', (e) => {
            e.stopPropagation();
            this.openModal(video.dataset.videoSrc);
          });

          wrapper.addEventListener('click', () => {
            this.openModal(video.dataset.videoSrc);
          });
        });

        this.modalClose.addEventListener('click', () => this.closeModal());
        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });

        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            const oldItemsPerPage = this.itemsPerPage;
            this.updateItemsPerPage();
            if (oldItemsPerPage !== this.itemsPerPage) {
              this.createPagination();
              this.currentPage = 0;
              this.updateActiveDot();
            }
          }, 250);
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
              const index = parseInt(entry.target.dataset.videoIndex);
              const newPage = Math.floor(index / this.itemsPerPage);
              if (newPage !== this.currentPage) {
                this.currentPage = newPage;
                this.updateActiveDot();
              }
            }
          });
        }, {
          threshold: 0.5,
          rootMargin: '0px'
        });

        this.items.forEach((item) => {
          observer.observe(item);
        });
      }

      openModal(videoSrc) {
        this.modalVideo.src = videoSrc;
        this.modal.classList.add('active');
        this.modalVideo.play();
        document.body.style.overflow = 'hidden';
      }

      closeModal() {
        this.modal.classList.remove('active');
        this.modalVideo.pause();
        this.modalVideo.src = '';
        document.body.style.overflow = '';
      }

      disconnectedCallback() {
        this.closeModal();
      }
    }

    customElements.define('video-grid-{{ ai_gen_id }}', VideoGrid{{ai_gen_id}});
  })();
</script>

