<style>
  .shopify-section--{{ section.id }}.section--upper_overlap::before {
/*     content: ''; */
    -webkit-clip-path: polygon(100% 0%, 0% 100%, 100% 100%);
    clip-path: polygon(100% 0%, 0% 100%, 100% 100%);
    position: absolute;
    width: 100%;
    background: {{ section.settings.overlap_color }};
    height: 100px;
    top: 0;
    z-index: 0;
  }
  .shopify-section--{{ section.id }}.section--upper_overlap {
    position: relative;
    margin-top: -70px;
  }
  .shopify-section--{{ section.id }}.section--upper_overlap .section-boundary-box {
    z-index: 1;
    position: relative;
  }
  .shopify-section--{{ section.id }} .single_image_area {
    background: {{ section.settings.bg_color_image }};
  }
  .shopify-section--{{ section.id }} .single_image_area .text-box {
    color: {{ section.settings.bg_color_text }};
  }
  @media only screen and (max-width: 1000px) {
    .shopify-section--{{ section.id }}.section--upper_overlap::before {
      top: -49px;
    }
    .shopify-section--{{ section.id }}.section--upper_overlap {
      margin-top: -50px;
    }
  }
  @media only screen and (max-width: 740px) {
    .shopify-section--{{ section.id }}.section--upper_overlap::before {
      content: '';
      -webkit-clip-path: polygon(100% 40%, 0% 100%, 100% 100%);
      clip-path: polygon(100% 40%, 0% 100%, 100% 100%);
      position: absolute;
      width: 100%;
      background: {{ section.settings.overlap_color }};
      height: 100px;
      top: -139px;
    }
    .shopify-section--{{ section.id }}.section--upper_overlap {
      margin-top: 0px;
    }
    .shopify-section--{{ section.id }}.section--upper_overlap .container {
      margin-top: 40px;
    }
    .shopify-section--{{ section.id }} .single_image_area {
      background: {{ section.settings.bg_color_image_mobile }};
    }
    .shopify-section--{{ section.id }} .single_image_area .text-box {
      color: {{ section.settings.bg_color_text_mobile }};
    }
  }
</style>

<section class="home-benefits-grillbot section shopify-section--{{ section.id }}{% if section.settings.section_upper_overlap %} section--upper_overlap{% endif %}">
  <div class="section-boundary-box">
<!--     <div class="container"> -->
      {% for block in section.blocks %}
          {% if block.type == "image_gallery" %}
            <div class="container">
              <div class="image_gallery">
                {% for i in (1..4) %}
                {% assign svg_icon_key = "image_" | append:i %}
                {% assign svg_text_key = "text_" | append:i %}
                {% assign svg_link_key = "link_" | append:i %}
                <div class="single_image_area">
                  {% if block.settings[svg_link_key] != blank %}
                    <a class="collection_link" href="{{ block.settings[svg_link_key] }}"></a>
                  {% endif %}
                  <div class="single_image_inner">
                    <div class="image-box">
                      {% if block.settings[svg_icon_key] != blank %}
                        <img src="{{ block.settings[svg_icon_key] | img_url:'original' }}">
                      {% else %}
                        {{- 'image' | placeholder_svg_tag: 'image-with-text__image placeholder-background' -}}
                      {% endif %}
                    </div>
                    <div class="text-box">
                    {% if block.settings[svg_text_key] != blank %}
                      {{ block.settings[svg_text_key]}}
                    {% endif %}
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          {% if block.type == "content_with_image" %}
            <div class="content_with_image_area">
              <div class="container">
                 <div class="content_with_image_inner {% if block.settings.position == 'left' %}image-text-reverse{% endif %}">
                   <div class="custom_content_wrapper">
                      {%- if block.settings.heading != blank -%}
                      <div class="heading_area">
                        <h3 class="heading h3">
                        {{ block.settings.heading  }}
                        </h3>
                      </div>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                      <div class="subheading_area">
                        <p class="heading heading--small">{{ block.settings.subheading | escape }}</p>
                      </div>
                      {%- endif -%}
                      <div class="content_list_area">
                          <div class="content_list_inner">
                            {% for i in (1..6) %}
                              {% assign svg_icon_key = "svg_icon_" | append:i %}
                              {% assign svg_text_key = "svg_text_" | append:i %}
                              {% if block.settings[svg_icon_key] != blank and block.settings[svg_text_key] != blank %}
                                <div class="single_block_area">
                                  <span class="icon"><img src="{{ block.settings[svg_icon_key] | img_url:'original' }}"></span>
                                  <span class="text">{{ block.settings[svg_text_key]}}</span>
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                      </div>
                     <div class="content_buttons_area">
                        {%- if block.settings.button_text_1 != blank -%}
                        <a href="{{ block.settings.button_link_1 }}" class="button button--primary button--primary-bg{% if block.settings.button_type1 %} outlined--button-primary{% endif %}">
                          {{ block.settings.button_text_1 }}{% if block.settings.button_type1 %}<img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_30.svg?v=1680953819" />{% endif %}
                        </a>
                          <style>
                            .shopify-section--{{ section.id }} .button--primary-bg {
                              color: {{ block.settings.first_button_color }};
                              background: {{ block.settings.first_button_bg }};
                            }
                            .shopify-section--{{ section.id }} .outlined--button-primary {
                              background: transparent;
                              color: #ffffff;
                              border-bottom: 2px solid #b6d22f;
                              justify-content: space-between !important;
                            }
                          </style>
                        {%- endif -%}
              
                        {%- if block.settings.button_text_2 != blank -%}
                        <a href="{{ block.settings.button_link_2 }}" class="button button--secondary button--secondary-bg{% if block.settings.button_type2 %} outlined--button-secondary{% endif %}">
                          {{ block.settings.button_text_2 }}{% if block.settings.button_type2 %}<img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_30.svg?v=1680953819" />{% endif %}
                        </a>
                          <style>
                            .shopify-section--{{ section.id }} .button--secondary-bg {
                              color: {{ block.settings.second_button_color }};
                              background: {{ block.settings.second_button_bg }};
                            }
                            .shopify-section--{{ section.id }} .outlined--button-secondary {
                              background: transparent;
                              color: #000000;
                              border-bottom: 2px solid #DE2A2C;
                              justify-content: space-between !important;
                            }
                          </style>
                        {%- endif -%}
                     </div>
                   </div>
                    <div class="custom_image_wrapper">
                      {% if block.settings.image != blank %}
                      <div class="image_ratio--wrapper" data-aos="fade-left">
                        <img src="{{ block.settings.image | img_url:'original' }}">
                      </div>
                      {% endif %}
                    </div>
                  </div>
              </div>
            </div>
          {% endif %}
      {% endfor %}
<!--     </div> -->
  </div>
</section>

