{%- comment -%}
  Choose right brush — uses your Shopify definitions:

  Metaobject type: grillbot_choose_right_heading_section
  - heading (single line)
  - subheading (single line)
  - content (multi-line text)

  Metaobject type: grillbot_choose_right_section_block
  - badge (single line)
  - badge_color (color)
  - image (file)
  - video (file)
  - heading (single line)
  - content (rich text)
  - link (link)
  - product_selection or product (product reference) — + Add at bottom of card

  Product metafields (custom.*) — set whichever you created:
  - Heading MO: grillbot_choose_right_heading_section (or grillbot_choose_right_section_heading)
  - Blocks list: grillbot_choose_right_section_block
{%- endcomment -%}

{%- assign head_mo = product.metafields.custom.grillbot_choose_right_heading_section.value
    | default: product.metafields.custom.grillbot_choose_right_heading_section
    | default: product.metafields.custom.grillbot_choose_right_section_heading.value
    | default: product.metafields.custom.grillbot_choose_right_section_heading
    | default: product.metafields.custom.grillbot_choose_right_brush_section_heading.value
    | default: product.metafields.custom.grillbot_choose_right_brush_section_heading
  -%}
  
  {%- assign brush_blocks = product.metafields.custom.grillbot_choose_right_section_block.value
    | default: product.metafields.custom.grillbot_choose_right_section_block
    | default: product.metafields.custom.grillbot_choose_right_brush_section_blocks.value
    | default: product.metafields.custom.grillbot_choose_right_brush_section_blocks
  -%}
  
  {%- assign wrap_mo = product.metafields.custom.grillbot_choose_right_brush_section.value
    | default: product.metafields.custom.grillbot_choose_right_brush_sections.value
  -%}
  
  {%- if head_mo == blank and wrap_mo != blank -%}
    {%- assign head_mo = wrap_mo -%}
  {%- endif -%}
  {%- if brush_blocks == blank and wrap_mo != blank -%}
    {%- assign brush_blocks = wrap_mo.blocks.value | default: wrap_mo.blocks -%}
  {%- endif -%}
  
  {%- if request.page_type == 'product' and product != blank -%}
    {%- assign crb_heading = '' -%}
    {%- assign crb_subheading = '' -%}
    {%- assign crb_content = '' -%}
    {%- if head_mo != blank -%}
      {%- assign crb_heading = head_mo.heading.value | default: head_mo.heading -%}
      {%- assign crb_subheading = head_mo.subheading.value | default: head_mo.subheading -%}
      {%- assign crb_content = head_mo.content.value | default: head_mo.content -%}
    {%- endif -%}
  
    {%- assign has_blocks = false -%}
    {%- if brush_blocks != blank and brush_blocks.size > 0 -%}
      {%- assign has_blocks = true -%}
    {%- endif -%}
  
    {%- if crb_heading != blank or crb_subheading != blank or crb_content != blank or has_blocks -%}
      {% style %}
        #shopify-section-{{ section.id }} .hb-choose-brush {
          background: {{ section.settings.background }};
          padding-top: {{ section.settings.padding_desktop_top }}px;
          padding-bottom: {{ section.settings.padding_desktop_bottom }}px;
          color: {{ section.settings.text_color }};
          overflow: hidden;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__head {
          text-align: center;
          margin: 0 0 32px;
        }
        #shopify-section-{{ section.id }} .hb-choose-brush__title {
          margin: 0 0 16px;
          font-family: Anton, sans-serif !important;
          font-weight: 400;
          font-size: 52px;
          line-height: 60px;
          text-transform: uppercase;
          color: {{ section.settings.text_color }};
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__sub {
          margin: 0 auto 16px;
          font-size: 16px;
          line-height: 22px;
          font-weight: 400;
          color: {{ section.settings.subheading_text_color }};
          background: {{ section.settings.subheading_background }};
          padding: 3px 14px;
          border-radius: 4px;
          display: inline-block;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__lead {
          max-width: 720px;
          font-size: 16px;
          line-height: 26px;
          font-weight: 400;
          color: {{ section.settings.text_color }};
          margin: 0 auto;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 48px;
          align-items: stretch;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__card .product-form__add-button {
          width: 285px;
          height: 40px;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card {
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
          padding: 0;
          border-radius: 12px;
          background: {{ section.settings.card_background }};
          border: 1px solid {{ section.settings.card_border_color }};
          box-sizing: border-box;
          min-height: 100%;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-badge {
          position: absolute;
          top: 16px;
          left: 16px;
          padding: 1px 14px;
          border-radius: 100px;
          font-size: 14px;
          line-height: 22px;
          font-weight: 400;
          color: {{ section.settings.card_badge_text_color }};
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-media {
          width: 100%;
          aspect-ratio: 426 / 313;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow: hidden;
          border-radius: 8px;
          min-height: 139px;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-media img,
        #shopify-section-{{ section.id }} .hb-choose-brush__card-media video,
        #shopify-section-{{ section.id }} .hb-choose-brush__card-media iframe {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-media video {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-title {
          margin: 12px 0 4px;
          font-size: 26px;
          line-height: 1;
          font-weight: 700;
          color: {{ section.settings.text_color }};
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-body {
          display: flex;
          flex-direction: column;
          align-items: center;
          flex: 1;
          width: 100%;
          min-height: 0;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__card-content {
          margin: 0;
          font-size: 16px;
          line-height: 26px;
          font-weight: 400;
          color: {{ section.settings.text_color }};
          text-align: center;
          max-width: 295px;
          padding: 0 5px 12px;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__card-footer {
          margin-top: auto;
          width: 100%;
          display: flex;
          justify-content: center;
          padding: 4px 0 20px;
          box-sizing: border-box;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-content p {
          margin: 0 0 4px;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__card-content a,#shopify-section-{{ section.id }} .hb-choose-brush__card-content em {
          color: #B6D22F;
          font-weight: 300;
        }
  
        #shopify-section-{{ section.id }} .hb-choose-brush__form {
          margin: 0;
          width: 100%;
          display: flex;
          justify-content: center;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__payment-container {
          width: 100%;
          display: flex;
          justify-content: center;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__payment-container .buyButton_capture {
          display: flex;
          justify-content: center;
        }

        #shopify-section-{{ section.id }} .hb-choose-brush__card-link,
        #shopify-section-{{ section.id }} button.hb-choose-brush__card-link {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          margin: 0;
          padding: 12px 28px;
          border: 0;
          border-radius: 100px;
          font-size: 16px;
          line-height: 22px;
          font-weight: 700;
          font-family: inherit;
          text-decoration: none;
          background: #B6D22F;
          color: #080808;
          cursor: pointer;
          box-sizing: border-box;
          appearance: none;
          -webkit-appearance: none;
        }

        #shopify-section-{{ section.id }} button.hb-choose-brush__card-link:disabled {
          opacity: 0.45;
          cursor: not-allowed;
        }
  
        @media screen and (max-width: 991px) {
          #shopify-section-{{ section.id }} .hb-choose-brush {
            padding-top: {{ section.settings.padding_mobile_top }}px;
            padding-bottom: {{ section.settings.padding_mobile_bottom }}px;
          }
          #shopify-section-{{ section.id }} .hb-choose-brush__title {
            font-size: 36px;
            line-height: 44px;
          }
  
          #shopify-section-{{ section.id }} .hb-choose-brush__grid {
            gap: 8px;
          }
        }
  
        @media screen and (max-width: 767px) {
          #shopify-section-{{ section.id }} .hb-choose-brush__head {
            margin: 0 0 24px;
          }
          #shopify-section-{{ section.id }} .hb-choose-brush__card-badge{
            font-size: 12px;
            line-height: 22px;
            left: 6px; 
            top: 6px;
          }
          #shopify-section-{{ section.id }} .hb-choose-brush__card-title{
            font-size: 16px;
            line-height: 26px;
            margin: 6px 0 4px;
          }
          #shopify-section-{{ section.id }} .hb-choose-brush__card-content{
            font-size: 13px;
            line-height: 18px;
            padding: 0 5px 16px;
          }
          #shopify-section-{{ section.id }} .hb-choose-brush__card-footer {
            padding-bottom: 16px;
          }

          #shopify-section-{{ section.id }} .hb-choose-brush__card-link,
          #shopify-section-{{ section.id }} button.hb-choose-brush__card-link {
            font-size: 14px;
            line-height: 20px;
            padding: 10px 20px;
          }

          #shopify-section-{{ section.id }} .hb-choose-brush__card .product-form__add-button {
          width: 100%;
          height: 40px;
        }
  
        }
      {% endstyle %}
  
      <section class="hb-choose-brush shopify-section--{{ section.id }}" aria-label="Choose the right brush">
        <div class="container">
          {%- if crb_heading != blank or crb_subheading != blank or crb_content != blank -%}
            <header class="hb-choose-brush__head">
              {%- if crb_subheading != blank -%}
                <p class="hb-choose-brush__sub">{{ crb_subheading | escape }}</p>
              {%- endif -%}
              {%- if crb_heading != blank -%}
                <h2 class="hb-choose-brush__title">{{ crb_heading | escape }}</h2>
              {%- endif -%}
              {%- if crb_content != blank -%}
                <div class="hb-choose-brush__lead">{{ crb_content | escape | newline_to_br }}</div>
              {%- endif -%}
            </header>
          {%- endif -%}
  
          {%- if has_blocks -%}
            <div class="hb-choose-brush__grid">
              {%- for card in brush_blocks -%}
                {%- assign card_mo = card.value | default: card -%}
                {%- assign b_badge = card_mo.badge.value | default: card_mo.badge -%}
                {%- assign b_badge_color = card_mo.badge_color.value | default: card_mo.badge_color -%}
                {%- assign b_img = card_mo.image.value | default: card_mo.image -%}
                {%- assign b_vid = card_mo.video.value | default: card_mo.video -%}
                {%- assign b_card_heading = card_mo.heading.value | default: card_mo.heading -%}
                {%- assign b_rich_mf = card_mo.content -%}
                {%- assign b_rich_val = card_mo.content.value | default: '' -%}
                {%- liquid
                  assign product_field_key = section.settings.card_product_field | default: 'product_selection' | strip
                  assign b_product = blank
                  assign b_product_field_set = false

                  assign b_product_mf = card_mo[product_field_key] | default: card[product_field_key]
                  if b_product_mf == blank
                    assign b_product_mf = card_mo.product_selection | default: card.product_selection | default: card_mo.product | default: card.product | default: card_mo.product_reference | default: card_mo.brush_product
                  endif

                  if b_product_mf != blank
                    assign b_product_field_set = true
                    assign b_product_candidate = b_product_mf.value | default: b_product_mf
                    if b_product_candidate != blank
                      if b_product_candidate.first != blank and b_product_candidate.id == blank
                        assign b_product_candidate = b_product_candidate.first
                      endif
                      if b_product_candidate.id != blank
                        assign b_product = b_product_candidate
                      elsif b_product_candidate.handle != blank
                        assign b_product = all_products[b_product_candidate.handle]
                      endif
                    endif
                  endif
                -%}

                {%- assign b_link = card_mo.link.value | default: card_mo.link -%}
                {%- assign b_link_url = blank -%}
                {%- assign b_link_text = blank -%}
                {%- if b_link != blank -%}
                  {%- assign b_link_text = b_link.title
                    | default: b_link.text
                    | default: b_link.label
                    | default: b_link.name
                  -%}
                  {%- assign b_link_url = b_link.url | default: b_link.href -%}
                  {%- if b_link_url == blank -%}
                    {%- assign b_link_url = b_link -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if b_product == blank and b_link_url != blank and b_link_url contains '/products/' -%}
                  {%- assign b_link_handle = b_link_url | split: '/products/' | last | split: '?' | first | split: '#' | first | split: '/' | first -%}
                  {%- if b_link_handle != blank -%}
                    {%- assign b_product = all_products[b_link_handle] -%}
                  {%- endif -%}
                {%- endif -%}
  
                {%- assign b_img_render = b_img -%}
                {%- if b_img != blank and b_img.preview_image != blank -%}
                  {%- assign b_img_render = b_img.preview_image -%}
                {%- endif -%}
  
                <article class="hb-choose-brush__card">
                  {%- if b_badge != blank -%}
                    <span
                      class="hb-choose-brush__card-badge"
                      {% if b_badge_color != blank %}
                        style="background-color: {{ b_badge_color }};"
                      {% endif %}
                    >
                      {{- b_badge | escape -}}
                    </span>
                  {%- endif -%}
  
                  {%- if b_vid != blank -%}
                    <div class="hb-choose-brush__card-media">
                      {%- if b_vid.sources != blank -%}
                        {{- b_vid | video_tag: image_size: '800x', controls: true, muted: false, playsinline: true -}}
                      {%- else -%}
                        <video controls playsinline preload="metadata" width="480" height="480">
                          <source src="{{ b_vid | file_url }}" type="video/mp4">
                        </video>
                      {%- endif -%}
                    </div>
                  {%- elsif b_img_render != blank -%}
                    {%- assign crb_card_alt = b_card_heading | default: '' | escape -%}
                    <div class="hb-choose-brush__card-media">
                      {{ b_img_render | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,400,600,800', sizes: '(min-width: 992px) 30vw, 90vw', alt: crb_card_alt }}
                    </div>
                  {%- endif -%}
  
                  <div class="hb-choose-brush__card-body">
                    {%- if b_card_heading != blank -%}
                      <h3 class="hb-choose-brush__card-title">{{ b_card_heading | escape }}</h3>
                    {%- endif -%}

                    {%- if b_rich_mf != blank and b_rich_val != blank -%}
                      <div class="hb-choose-brush__card-content rte">
                        {{ b_rich_mf | metafield_tag }}
                      </div>
                    {%- endif -%}

                    {%- if b_product != blank -%}
                      {%- assign b_variant = b_product.selected_or_first_available_variant -%}
                      {%- assign b_can_add = false -%}
                      {%- if b_variant != blank and b_variant.available -%}
                        {%- assign b_can_add = true -%}
                      {%- endif -%}
                      {%- assign brush_form_id = 'hb-brush-form-' | append: section.id | append: '-' | append: forloop.index -%}
                      <div class="hb-choose-brush__card-footer">
                        {%- form 'product', b_product, is: 'product-form', id: brush_form_id, class: 'hb-choose-brush__form' -%}
                          <input type="hidden" name="id" value="{{ b_variant.id }}">
                          <input type="hidden" name="quantity" value="1">

                          <product-payment-container
                            form-id="{{ brush_form_id }}"
                            data-product-id="{{ b_product.id }}"
                            class="product-form__payment-container hb-choose-brush__payment-container"
                          >
                            <div class="buyButton_capture">
                              <button
                                type="submit"
                                is="loader-button"
                                data-use-primary
                                data-product-add-to-cart-button
                                class="product-form__add-button button hb-choose-brush__card-link button--primary"
                                {% unless b_can_add %}
                                  disabled
                                {% endunless %}
                              >
                                <span class="loader-button__text">
                                  {%- if b_can_add -%}
                                    {{- section.settings.add_button_label | default: '+ Add' | escape -}}
                                  {%- else -%}
                                    Sold out
                                  {%- endif -%}
                                </span>
                              </button>
                            </div>
                          </product-payment-container>
                        {%- endform -%}
                      </div>
                    {%- elsif b_link_url != blank -%}
                      <div class="hb-choose-brush__card-footer">
                        <a class="hb-choose-brush__card-link" href="{{ b_link_url }}" data-instant>
                          {{- b_link_text | default: 'Learn more' | escape -}}
                        </a>
                      </div>
                    {%- elsif request.design_mode and b_product_field_set -%}
                      <div class="hb-choose-brush__card-footer">
                        <span class="hb-choose-brush__card-link" style="opacity: 0.45; pointer-events: none;" title="Product field is set but could not be loaded. Check field API key and product channel.">
                          {{- section.settings.add_button_label | default: '+ Add' | escape -}}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                </article>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </section>

      <script>
        (function () {
          var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
          if (!sectionRoot || sectionRoot.dataset.hbBrushFormFallback === '1') return;
          sectionRoot.dataset.hbBrushFormFallback = '1';

          function getCartSectionIds() {
            var ids = [];
            document.querySelectorAll('cart-items-component').forEach(function (el) {
              if (el.dataset && el.dataset.sectionId) ids.push(el.dataset.sectionId);
            });
            return ids;
          }

          function dispatchCartUpdate(cart, variantId, productId, sections) {
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: cart,
                  sourceId: String(variantId),
                  data: {
                    source: 'hb-choose-brush',
                    itemCount: 1,
                    productId: String(productId),
                    sections: sections || {},
                  },
                },
              })
            );
          }

          sectionRoot.querySelectorAll('.hb-choose-brush__form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
              if (customElements.get('product-form')) return;

              event.preventDefault();

              var submitBtn = form.querySelector('button[type="submit"]');
              if (submitBtn && submitBtn.disabled) return;

              var formData = new FormData(form);
              var variantId = formData.get('id');
              if (!variantId || !window.Theme || !Theme.routes || !Theme.routes.cart_add_url) return;

              var sectionIds = getCartSectionIds();
              if (sectionIds.length) {
                formData.append('sections', sectionIds.join(','));
              }

              if (submitBtn) submitBtn.disabled = true;

              fetch(Theme.routes.cart_add_url, {
                method: 'POST',
                body: formData,
                headers: { Accept: 'application/json' },
              })
                .then(function (response) {
                  return response.json();
                })
                .then(function (data) {
                  if (data.status) {
                    console.error('Add to cart failed:', data.message || data.description || data);
                    return;
                  }
                  return fetch('/cart.js').then(function (r) {
                    return r.json();
                  }).then(function (cart) {
                    var productId =
                      form.querySelector('[data-product-id]')?.dataset.productId || '';
                    dispatchCartUpdate(cart, variantId, productId, data.sections);
                  });
                })
                .catch(function (err) {
                  console.error(err);
                })
                .finally(function () {
                  if (submitBtn && !submitBtn.hasAttribute('data-force-disabled')) {
                    submitBtn.disabled = false;
                  }
                });
            });
          });
        })();
      </script>
    {%- endif -%}
  {%- endif -%}
  
  {% schema %}
  {
    "name": "GB - Choose brush",
    "class": "shopify-section--grillbot-choose-right-brush",
    "disabled_on": {
      "templates": ["password"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Header (theme)"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Section background",
        "default": "#0d0d0d"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Heading & card text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "subheading_background",
        "label": "Subheading background",
        "default": "#0d0d0d",
        "info": "Match section background for flat text, or use a highlight."
      },
      {
        "type": "color",
        "id": "subheading_text_color",
        "label": "Subheading text color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "card_background",
        "label": "Card background",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "card_border_color",
        "label": "Card border",
        "default": "#2a2a2a"
      },
      {
        "type": "color",
        "id": "card_badge_text_color",
        "label": "Card badge text color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Add to cart button"
      },
      {
        "type": "text",
        "id": "add_button_label",
        "label": "Button label",
        "default": "+ Add",
        "info": "Shown on each card when that card’s metaobject has a Product field set."
      },
      {
        "type": "text",
        "id": "card_product_field",
        "label": "Card product field key",
        "default": "product_selection",
        "info": "API key for the Product selection field on grillbot_choose_right_section_block (e.g. product_selection or product)."
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "padding_desktop_top",
        "label": "Padding top (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 80
      },
      {
        "type": "range",
        "id": "padding_desktop_bottom",
        "label": "Padding bottom (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 160
      },
      {
        "type": "range",
        "id": "padding_mobile_top",
        "label": "Padding top (mobile)",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 48
      },
