{% style %}

.hb-image-marquee{
    background-color: {{ section.settings.bg-color }};
}
.hb-image-marquee .container{
    padding: 0 60px;
}

      .hb-image-marquee .image-slider-box{
        padding: 24px 0;
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        
    }
    .hb-image-marquee .image-slider-box::before,.hb-image-marquee .image-slider-box::after{
        content: "";
        position: absolute;
        width: 118px;
        top: 0;
        bottom: 0;
        z-index: 1;
        
    }
    .hb-image-marquee .image-slider-box::before{left: 0;
        background: linear-gradient(-90deg, rgba(0, 0, 0, 0.00) -77.54%, rgba(0, 0, 0, 0.84) 26.56%, #000 99.94%);

    }
    .hb-image-marquee .image-slider-box::after{right: 0;
        background: linear-gradient(90deg, rgba(0, 0, 0, 0.00) -77.54%, rgba(0, 0, 0, 0.84) 26.56%, #000 99.94%);

    }
  .hb-image-marquee .marquee-track {
    display: flex;
    gap: 64px;
    align-items: center;
    will-change: transform;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }


      .marquee-image-box {
        flex: 0 0 auto;
      }

      .marquee-image-box img {
        width: 100%;
        height: auto;
        max-height: 60px;
        display: block;
      }
      @media screen and (max-width: 991px){
        .hb-image-marquee .image-slider-box::before,.hb-image-marquee .image-slider-box::after{width: 30px;}
      }
      @media screen and (max-width: 767px){
        .hb-image-marquee .image-slider-box::before,.hb-image-marquee .image-slider-box::after{width: 10px;}
        .hb-image-marquee .image-slider-box{padding-inline: 0;}
        .hb-image-marquee .marquee-track {gap: 32px;}
      }
{% endstyle %}

<div class="hb-image-marquee">
  <div class="container">
  <div class="image-slider-box">
    <div class="marquee-track">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="marquee-image-box">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
                <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="auto" alt="Marquee Image">
              </a>
            {% else %}
              <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="auto" alt="Marquee Image">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="marquee-image-box">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
                <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="auto" alt="Marquee Image">
              </a>
            {% else %}
              <img src="{{ block.settings.image | img_url: 'master' }}" width="100%" height="auto" alt="Marquee Image">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
      </div>
    </div>
  </div>
</div>
{% javascript %}
  function setupMarquee() {
    const marquee = document.querySelector('.hb-image-marquee');
    const track = marquee.querySelector('.marquee-track');
    track.style.animation = 'none';
    const contentWidth = track.scrollWidth;
    const containerWidth = marquee.offsetWidth;
    const duration = contentWidth / 100;
    const animName = 'marqueeScroll-' + Math.floor(Math.random() * 10000);
    const keyframes = `
    @keyframes ${animName} {
      0% { transform: translateX(0); }
      100% { transform: translateX(-${contentWidth / 2}px); }
    }
  `;
    const style = document.createElement('style');
    style.innerHTML = keyframes;
    document.head.appendChild(style);
    track.style.animation = `${animName} ${duration}s linear infinite`;
  }
  window.addEventListener('load', setupMarquee);
  window.addEventListener('resize', setupMarquee);
{% endjavascript %}

{% schema %}
{
  "name": "Grillbot Image Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg-color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Marquee Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Grillbot Image Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
