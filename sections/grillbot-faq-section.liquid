<section class="hb-faq shopify-section--{{ section.id }}" aria-label="Frequently asked questions">
  <div class="container">
    <div class="hb-faq__layout">
      <div class="hb-faq__left">
        {%- if faq_heading != blank -%}
          <h2 class="hb-faq__title">{{ faq_heading | escape | newline_to_br }}</h2>
        {%- endif -%}

        {%- if faq_link != blank and faq_button_url != blank -%}
          <a class="hb-faq__btn" href="{{ faq_button_url }}" aria-label="{{ faq_button_text | escape }}">
            {{ faq_button_text | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if has_faqs -%}
        <div class="hb-faq__items">
          {%- for block in faqs -%}
            {%- assign q = block.settings.question -%}
            {%- assign a_val = block.settings.answer -%}
            {%- assign faq_open = block.settings.default_open -%}

            {%- if q != blank and a_val != blank -%}
              <details class="hb-faq__item"{% if faq_open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary class="hb-faq__toggle">
                  <span>{{ q | escape | newline_to_br }}</span>
                  <span class="hb-faq__icon" aria-hidden="true">
                    {{ 'accordion-arrow.svg' | inline_asset_content }}
                  </span>
                </summary>
                <div class="hb-faq__content">
                  {{ a_val }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% endif %}



{% schema %}
{
  "name": "GB - FAQ",
  "class": "shopify-section--grillbot-faq",
  "disabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Base text color", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_fallback_text", "label": "Button text fallback", "default": "Ask Us Anything →", "info": "Used when the link field has no label/title." },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#B6D22F" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#080808" },

    { "type": "header", "content": "FAQs" },
    { "type": "color", "id": "faq_bg", "label": "FAQ item background", "default": "#0d0d0d" },
    { "type": "color", "id": "faq_border", "label": "FAQ border color", "default": "#2a2a2a" },
    { "type": "color", "id": "faq_heading_color", "label": "FAQ heading color", "default": "#ffffff" },
    { "type": "color", "id": "faq_text_color", "label": "FAQ content color", "default": "#d9d9d9" },

    { "type": "header", "content": "SEO" },
    {
      "type": "checkbox",
      "id": "enable_faq_structured_data",
      "label": "Enable FAQ structured data (JSON-LD)",
      "default": true,
      "info": "Hidden markup for Google and other search engines. Does not change how the section looks on the storefront."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_desktop_top", "label": "Padding top (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_desktop_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 220, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_mobile_top", "label": "Padding top (mobile)", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_mobile_bottom", "label": "Padding bottom (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
   "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "textarea",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all items.</p>"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    { "name": "GB - FAQ", "category": "Custom" }
  ]
}
{% endschema %}

