{%- comment -%}
Grillbot - Before & After (metaobject driven)

Expected metafields (pick the one your admin created):
1) product.metafields.custom.grillbot_before_after_section.value
2) product.metafields.custom.grillbot_before_after.value

Metaobject fields (based on your screenshot):
- Before Image: before_image
- After Image: after_image
{%- endcomment -%}

{%- assign ba_mo = product.metafields.custom.grillbot_before_after_section.value | default: product.metafields.custom.grillbot_before_after.value -%}

  {%- assign ba_before_image = ba_mo.before_image.value | default: ba_mo.before_image -%}
  {%- assign ba_after_image = ba_mo.after_image.value | default: ba_mo.after_image -%}

  {%- if ba_before_image == blank -%}
    {%- assign ba_before_image = ba_mo.before_image | default: ba_mo.before.value | default: ba_mo.before | default: ba_mo.before_image_1.value | default: ba_mo.before_image_1 -%}
  {%- endif -%}
  {%- if ba_after_image == blank -%}
    {%- assign ba_after_image = ba_mo.after_image | default: ba_mo.after.value | default: ba_mo.after | default: ba_mo.after_image_1.value | default: ba_mo.after_image_1 -%}
  {%- endif -%}

  {% style %}
    #shopify-section-{{ section.id }} .hb-grillbot-before-after {
      background: {{ section.settings.background }};
      padding-top: {{ section.settings.padding-desktop-top }}px;
      padding-bottom: {{ section.settings.padding-desktop-bottom }}px;
      overflow: hidden;
      color: {{ section.settings.text_color }};
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__top {
      text-align: center;
      margin: 0 0 32px;
    }
    #shopify-section-{{ section.id }} .container-fluid {
      max-width: 1440px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__subheading {
      
      color: {{ section.settings.text_color }};
      font-size: 16px;
      line-height: 22px;
      font-weight: 400;
      padding: 3px 14px;
      border-radius: 4px;
      background: {{ section.settings.subheading_background }};
      margin-bottom: 16px;
      display: inline-block;
      color: {{ section.settings.subheading_text_color }};
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__heading {
      margin: 0;
      font-family: Anton !important;
      font-weight: 400;
      line-height: 60px;
      font-size: 52px;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__compare {
      position: relative;
      width: 100%;
      min-height: 648px;
      overflow: hidden;
      background: rgba(0,0,0,0.05);
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__compare img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__img--after {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      /* Show AFTER on the right side (slider controls the left edge of AFTER). */
      clip-path: inset(0 0 0 50%);
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__img--before {
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__divider {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 4px;
      background: rgba(255,255,255,0.9);
      pointer-events: none;
      z-index: 3;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__thumb {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 64px;
      height: 64px;
      border-radius: 0;
      background: transparent;
      border: 0;
      transform: translate(-50%, -50%);
      z-index: 4;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__thumb svg {
      display: block;
      width: 64px;
      height: 64px;
    }

    #shopify-section-{{ section.id }} .hb-grillbot-before-after__range {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      z-index: 3;
      margin: 0;
      width: 100%;
      cursor: ew-resize;
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
    }

    
    @media screen and (max-width: 991px) {
      #shopify-section-{{ section.id }} .hb-grillbot-before-after {
        padding-top: {{ section.settings.padding-mobile-top }}px;
        padding-bottom: {{ section.settings.padding-mobile-bottom }}px;
      }
      #shopify-section-{{ section.id }} .hb-grillbot-before-after__heading { font-size: 36px; line-height: 44px; }
    }

    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .hb-grillbot-before-after__heading { font-size: 24px; line-height: 24px; }
      #shopify-section-{{ section.id }} .hb-grillbot-before-after__subheading { margin-bottom: 12px; }
      #shopify-section-{{ section.id }} .hb-grillbot-before-after__compare{
        max-height: 500px;
        min-height: 320px;
      }
    }
  {% endstyle %}
  {%- if request.page_type == 'product' and product != blank -%}
  <section
    class="hb-grillbot-before-after home-before-after-grilling-section section shopify-section--{{ section.id }}"
    aria-label="Grillbot Before After"
  >
    <div class="container-fluid">
      {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
        <div class="hb-grillbot-before-after__top">
          {%- if section.settings.subheading != blank -%}
            <div class="hb-grillbot-before-after__subheading">{{ section.settings.subheading | escape }}</div>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="hb-grillbot-before-after__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if ba_before_image != blank or ba_after_image != blank -%}
        <div class="hb-grillbot-before-after__compare" data-hb-grillbot-compare>
          {%- if ba_before_image != blank -%}
            {{ ba_before_image | image_url: width: 768, format: 'webp' | image_tag: loading: 'lazy', widths: '320, 480, 576, 768', sizes: '(max-width: 767px) calc(100vw - 32px), min(100vw, 1440px)', class: 'hb-grillbot-before-after__img hb-grillbot-before-after__img--before', alt: 'Before Image', width: 568, height: 320 }}
          {%- endif -%}
          {%- if ba_after_image != blank -%}
            {{ ba_after_image | image_url: width: 768, format: 'webp' | image_tag: loading: 'lazy', widths: '320, 480, 576, 768', sizes: '(max-width: 767px) calc(100vw - 32px), min(100vw, 1440px)', class: 'hb-grillbot-before-after__img hb-grillbot-before-after__img--after', alt: 'After Image', width: 568, height: 320 }}
          {%- endif -%}

          <div class="hb-grillbot-before-after__divider" data-divider></div>
          <div class="hb-grillbot-before-after__thumb" data-thumb aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" fill="none">
              <rect x="1.5" y="1.5" width="60.325" height="60.325" rx="30.1625" fill="#B6D22F"/>
              <rect x="1.5" y="1.5" width="60.325" height="60.325" rx="30.1625" stroke="white" stroke-width="3"/>
              <path d="M13.8613 32.2628L23.4613 25.8628L23.4613 38.6628L13.8613 32.2628Z" fill="white"/>
              <path d="M49.4629 32.2628L39.8629 25.8628L39.8629 38.6628L49.4629 32.2628Z" fill="white"/>
            </svg>
          </div>

          <input
            class="hb-grillbot-before-after__range"
            type="range"
            min="0"
            max="100"
            value="50"
            step="0.1"
            aria-label="Before and after slider"
          />
        </div>
      {%- endif -%}
    </div>
  </section>

{% else %}

<section
    class="hb-grillbot-before-after home-before-after-grilling-section section shopify-section--{{ section.id }}"
    aria-label="Grillbot Before After"
  >
    <div class="container-fluid">
      {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
        <div class="hb-grillbot-before-after__top">
          {%- if section.settings.subheading != blank -%}
            <div class="hb-grillbot-before-after__subheading">{{ section.settings.subheading | escape }}</div>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="hb-grillbot-before-after__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.before_image != blank or section.settings.after_image != blank -%}
        <div class="hb-grillbot-before-after__compare" data-hb-grillbot-compare>
          {%- if section.settings.before_image != blank -%}
            {{
              section.settings.before_image
              | image_url: width: 768, format: 'webp'
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 576, 768',
                sizes: '(max-width: 767px) calc(100vw - 32px), min(100vw, 1440px)',
                class: 'hb-grillbot-before-after__img hb-grillbot-before-after__img--before',
                alt: 'Before Image',
                width: 568,
                height: 320
            }}
          {%- endif -%}
          {%- if section.settings.after_image != blank -%}
            {{
              section.settings.after_image
              | image_url: width: 768, format: 'webp'
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 576, 768',
                sizes: '(max-width: 767px) calc(100vw - 32px), min(100vw, 1440px)',
                class: 'hb-grillbot-before-after__img hb-grillbot-before-after__img--after',
                alt: 'After Image',
                width: 568,
                height: 320
            }}
          {%- endif -%}

          <div class="hb-grillbot-before-after__divider" data-divider></div>
          <div class="hb-grillbot-before-after__thumb" data-thumb aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" fill="none">
              <rect x="1.5" y="1.5" width="60.325" height="60.325" rx="30.1625" fill="#B6D22F"/>
              <rect x="1.5" y="1.5" width="60.325" height="60.325" rx="30.1625" stroke="white" stroke-width="3"/>
              <path d="M13.8613 32.2628L23.4613 25.8628L23.4613 38.6628L13.8613 32.2628Z" fill="white"/>
              <path d="M49.4629 32.2628L39.8629 25.8628L39.8629 38.6628L49.4629 32.2628Z" fill="white"/>
            </svg>
          </div>

          <input
            class="hb-grillbot-before-after__range"
            type="range"
            min="0"
            max="100"
            value="50"
            step="0.1"
            aria-label="Before and after slider"
          />
        </div>
      {%- endif -%}
    </div>
  </section>

{% endif %}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var compare = root.querySelector('[data-hb-grillbot-compare]');
      if (!compare) return;

      var range = compare.querySelector('input[type="range"]');
      var afterImg = compare.querySelector('.hb-grillbot-before-after__img--after');
      var divider = compare.querySelector('[data-divider]');
      var thumb = compare.querySelector('[data-thumb]');
      if (!range || !afterImg || !divider || !thumb) return;

      var AUTO_MIN = 28;
      var AUTO_MAX = 72;
      var AUTO_HALF_CYCLE_MS = 3200;

      function setClip(value) {
        var v = Math.max(0, Math.min(100, Number(value) || 0));
        // Slider value v: AFTER ko left side se clip karo taake left = BEFORE, right = AFTER.
        afterImg.style.clipPath = 'inset(0 0 0 ' + v + '%)';
        divider.style.left = v + '%';
        thumb.style.left = v + '%';
      }

      function easeInOutSine(t) {
        return 0.5 - Math.cos(Math.PI * t) / 2;
      }

      var latest = Number(range.value);
      var manualRaf = null;
      var autoAnimating = false;
      var userHasInteracted = false;
      var autoRaf = null;
      var autoStartTime = null;
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function scheduleManual() {
        if (manualRaf) return;
        manualRaf = window.requestAnimationFrame(function () {
          manualRaf = null;
          setClip(latest);
        });
      }

      function stopAuto() {
        autoAnimating = false;
        if (autoRaf) {
          window.cancelAnimationFrame(autoRaf);
          autoRaf = null;
        }
        autoStartTime = null;
      }

      function tickAuto(now) {
        if (!autoAnimating) return;
        if (!autoStartTime) autoStartTime = now;

        var cycleMs = AUTO_HALF_CYCLE_MS * 2;
        var elapsed = (now - autoStartTime) % cycleMs;
        var half = elapsed < AUTO_HALF_CYCLE_MS;
        var t = (half ? elapsed : elapsed - AUTO_HALF_CYCLE_MS) / AUTO_HALF_CYCLE_MS;
        var eased = easeInOutSine(t);
        var value = half
          ? AUTO_MIN + (AUTO_MAX - AUTO_MIN) * eased
          : AUTO_MAX - (AUTO_MAX - AUTO_MIN) * eased;

        latest = value;
        range.value = String(value);
        setClip(value);
        autoRaf = window.requestAnimationFrame(tickAuto);
      }

      function startAuto() {
        if (userHasInteracted || prefersReducedMotion || autoAnimating) return;
        autoAnimating = true;
        autoStartTime = null;
        autoRaf = window.requestAnimationFrame(tickAuto);
      }

      function onUserInteract() {
        userHasInteracted = true;
        stopAuto();
      }

      setClip(latest);

      range.addEventListener('input', function () {
        onUserInteract();
        latest = Number(this.value);
        scheduleManual();
      });

      range.addEventListener('pointerdown', onUserInteract);
      range.addEventListener('touchstart', onUserInteract, { passive: true });
      range.addEventListener('keydown', onUserInteract);

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              startAuto();
            } else {
              stopAuto();
            }
          });
        }, { threshold: 0.25 });
        observer.observe(compare);
      } else {
        startAuto();
      }
    })();
  </script>

{% schema %}
{
  "name": "Grillbot - Before & After",
  "class": "shopify-section--grillbot-before-after",
  "disabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Before & After"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results in Seconds"
    },
     {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "subheading_background",
      "label": "Subheading Background",
      "default": "#B6D22F"
    },
    {
      "type": "color",
      "id": "subheading_text_color",
      "label": "Subheading Color",
      "default": "#080808"
    },
    {
      "type": "range",
      "id": "padding-desktop-top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-desktop-bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-mobile-top",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-mobile-bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Grillbot - Before & After",
      "category": "Custom"
    }
  ]
}
{% endschema %}

