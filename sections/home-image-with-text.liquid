        },
        {
          "type": "text",
          "id": "svg_text_2",
          "label": "SVG Text 2"
        },
        {
          "type":"url",
          "id":"svg_link_2",
          "label":"Link"
        },
        {
          "type": "image_picker",
          "id": "svg_icon_3",
          "label": "SVG Icon 3",
