

<section class="cat-grid" style="
  --cat-pt-desktop: {{ section.settings.padding_top_desktop }}px;
  --cat-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
  --cat-pt-mobile: {{ section.settings.padding_top_mobile }}px;
  --cat-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  --cat-cols-desktop: {{ section.settings.columns_desktop }};
  --cat-cols-mobile: {{ section.settings.columns_mobile }};
">
  <div class="cat-grid__wrapper">

    {%- comment -%} ── Header Row ── {%- endcomment -%}
    <div class="cat-grid__header">
      <h2 class="cat-grid__title">
        {{ section.settings.heading | default: 'Shop By Category' }}
      </h2>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="cat-grid__btn" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    {%- comment -%} ── Category Grid ── {%- endcomment -%}
    <div class="cat-grid__grid">
      {% for block in section.blocks %}
        
        <a
          class="cat-grid__card card--{{block.id}}"
          href="{{ block.settings.link | default: '#' }}"
          {{ block.shopify_attributes }}
          
        >
          {% if block.settings.image != blank %}
            <img
              class="cat-grid__img desktopimage"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.label }}"
              loading="lazy"
              width="600"
              height="400"
            >
            <img
              class="cat-grid__img mobileimage"
              src="{{ block.settings.mobileimage | image_url: width: 600 }}"
              alt="{{ block.settings.label }}"
              loading="lazy"
              width="600"
              height="400"
            >
          {% else %}
            <div class="cat-grid__img cat-grid__img--placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}

          {% if block.settings.label != blank %}
            <span class="cat-grid__label" style="color:{{block.settings.text-color}}">{{ block.settings.label }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  /* ── Section wrapper ── */
  .cat-grid {
    background-color: #ffffff;
    padding-top: var(--cat-pt-desktop);
    padding-bottom: var(--cat-pb-desktop);
  }

  .cat-grid__wrapper {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ── Header row ── */
  .cat-grid__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .cat-grid__title {
  
    color: var(--Black, #080808);
    font-family: Anton!important;
    font-size: 52px;
    font-style: normal;
    font-weight: 400;
    line-height: 60px;
    letter-spacing: -0.8px;
    text-transform: uppercase;
    margin:0px;
}

  /* Shop All button */
 a.cat-grid__btn {
    display: flex;
    width: 231px;
    height: 48px;
    padding: 10px;
    justify-content: center;
    align-items: center;
    gap: 14px;
    border-radius: 100px;
    background: #B6D22F;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 22px;
}
.cat-grid__img.mobileimage {display:none;
}

  .cat-grid__btn:hover {
    opacity: 0.85;
  }

  /* ── Grid ── */
  .cat-grid__grid {
    display: flex;
    flex-wrap: wrap;
    gap:8px;
  }

  /* ── Card ── */
  .cat-grid__card {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 1 / 0.52;
    cursor: pointer;
  }

  .cat-grid__card:hover .cat-grid__img {
    transform: scale(1.04);
  }

  /* ── Image ── */
  .cat-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .cat-grid__img--placeholder {
    background-color: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cat-grid__img--placeholder .placeholder-svg {
    width: 60px;
    height: 60px;
    fill: #555;
  }

  /* ── Label (bottom-left overlay) ── */
  

  span.cat-grid__label {
    color: #FFF;
    font-family: Rubik;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 30px;
    padding: 16px 24px;
     position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
}

.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 1),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 2),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 3) {
  width: calc(33.3333% - 5.55555px);
}

.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 4),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 5),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 6),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 7) {
  width: calc(25% - 6px);
}

  /* ── Mobile ── */
  @media screen and (max-width: 768px) {
    .cat-grid {
      padding-top: var(--cat-pt-mobile);
      padding-bottom: var(--cat-pb-mobile);
    }

    .cat-grid__wrapper {

    padding: 0 16px;
}

   .cat-grid__grid > .cat-grid__card:nth-of-type(7n + 1),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 2),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 3) {
  width:100%;
  aspect-ratio:1/0.48;
}

.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 4),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 5),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 6),
.cat-grid__grid > .cat-grid__card:nth-of-type(7n + 7) {
  width: calc(50% - 4px);
  
    aspect-ratio: 1 / 1.12;
}

.cat-grid__title {
    font-size: 20px;
    color: var(--Black, #080808);
    font-family: Anton;
    font-size: 36px;
    font-style: normal;
    font-weight: 400;
    line-height: 44px;
    text-transform: uppercase;
}

    .cat-grid__btn {
      font-size: 12px;
      padding: 8px 16px;
    }

    .cat-grid__label {
      font-size: 12px;
    }

    .cat-grid__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 8px;
}
a.cat-grid__btn {
    display: flex;
    width: 231px;
    height: 48px;
    padding: 10px;
    justify-content: center;
    align-items: center;
    gap: 14px;
    border-radius: 100px;
    background: #B6D22F;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 22px;
    width: 100%;
}
.cat-grid__img.mobileimage{
display:block;
}
.cat-grid__img.desktopimage{
    display:none;

}
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "category-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Grid Columns"
    },
   
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "image_picker",
          "id": "mobileimage",
          "label": "Category Mobile Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Category Label",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
        "type":"color",
        "label":"Add text color",
        "id":"text-color"
        }

      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        {
          "type": "category",
          "settings": { "label": "Grillbots" }
        },
        {
          "type": "category",
          "settings": { "label": "Fliptray" }
        },
        {
          "type": "category",
          "settings": { "label": "Apron" }
        },
        {
          "type": "category",
          "settings": { "label": "Heatshield" }
        },
        {
          "type": "category",
          "settings": { "label": "Brushes" }
        },
        {
          "type": "category",
          "settings": { "label": "Accessories" }
        },
        {
          "type": "category",
          "settings": { "label": "Bundles" }
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
