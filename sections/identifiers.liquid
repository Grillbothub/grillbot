        "type": "identifier",
        "name": "Identifier",
        "settings": [
          {
            "type": "text",
            "id": "Identifier",
            "label": "Identifier"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Identifiers"
      }
    ]
  }
{% endschema %}

