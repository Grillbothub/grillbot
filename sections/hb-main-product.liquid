{%- unless template.suffix contains 'quick-buy' -%}
    {{ 'hb-grillbots-product.css' | asset_url | stylesheet_tag }}
    <style>
      #shopify-section-{{ section.id }} {
        {%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
  
        {%- if buy_buttons_block.settings.show_payment_button -%}
          {%- if buy_buttons_block.settings.atc_button_background == 'rgba(0,0,0,0)' -%}
            {%- assign secondary_button_background = settings.secondary_button_background -%}
          {%- else -%}
            {%- assign secondary_button_background = buy_buttons_block.settings.atc_button_background -%}
          {%- endif -%}
  
          {%- if buy_buttons_block.settings.atc_button_text_color == 'rgba(0,0,0,0)' -%}
            {%- assign secondary_button_text_color = settings.secondary_button_text_color -%}
          {%- else -%}
            {%- assign secondary_button_text_color = buy_buttons_block.settings.atc_button_text_color -%}
          {%- endif -%}
  
          {%- if buy_buttons_block.settings.buy_now_button_background == 'rgba(0,0,0,0)' -%}
            {%- assign primary_button_background = settings.primary_button_background -%}
          {%- else -%}
            {%- assign primary_button_background = buy_buttons_block.settings.buy_now_button_background -%}
          {%- endif -%}
  
          {%- if buy_buttons_block.settings.buy_now_button_text_color == 'rgba(0,0,0,0)' -%}
            {%- assign primary_button_text_color = settings.primary_button_text_color -%}
          {%- else -%}
            {%- assign primary_button_text_color = buy_buttons_block.settings.buy_now_button_text_color -%}
          {%- endif -%}
        {%- else -%}
          {%- if buy_buttons_block.settings.atc_button_background == 'rgba(0,0,0,0)' -%}
            {%- assign primary_button_background = settings.primary_button_background -%}
          {%- else -%}
            {%- assign primary_button_background = buy_buttons_block.settings.atc_button_background -%}
          {%- endif -%}
  
          {%- if buy_buttons_block.settings.atc_button_text_color == 'rgba(0,0,0,0)' -%}
            {%- assign primary_button_text_color = settings.primary_button_text_color -%}
          {%- else -%}
            {%- assign primary_button_text_color = buy_buttons_block.settings.atc_button_text_color -%}
          {%- endif -%}
        {%- endif -%}
  
        --primary-button-background: {{ primary_button_background.red }}, {{ primary_button_background.green }}, {{ primary_button_background.blue }};
        --primary-button-text-color: {{ primary_button_text_color.red }}, {{ primary_button_text_color.green }}, {{ primary_button_text_color.blue }};
        --secondary-button-background: {{ secondary_button_background.red }}, {{ secondary_button_background.green }}, {{ secondary_button_background.blue }};
        --secondary-button-text-color: {{ secondary_button_text_color.red }}, {{ secondary_button_text_color.green }}, {{ secondary_button_text_color.blue }};
      }
    </style>
  
    <section class="custom-product-template--wrapper custom-grillbot-product">
      {%- if section.settings.show_sticky_add_to_cart and product.available -%}
        {%- render 'product-sticky-form', product: product -%}
      {%- endif -%}
  
      <div class="container">
        {% if section.settings.show_breadcrumb %}
        <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb text--xsmall text--subdued hidden-phone">
          <ol class="breadcrumb__list" role="list">
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
            </li>
  
            {%- if collection -%} 
              <li class="breadcrumb__item">
                <a class="breadcrumb__link" href="{{ collection.url }}">{{- collection.title -}}</a>
              </li>
            {%- endif -%}
  
            <li class="breadcrumb__item">
              <span class="breadcrumb__link" aria-current="page">{{ product.title }}</span>
            </li>
          </ol>
        </nav>
         {% endif %}
        <!-- PRODUCT TOP PART -->
        <div class="product product--thumbnails-{{ section.settings.desktop_thumbnails_position }}">
          <div class="product-template-block">
            {%- assign hb_gift_badge = product.metafields.custom.gift_badge -%}
            {%- if hb_gift_badge != blank -%}
              {%- assign hb_gift_badge_alt = hb_gift_badge.alt -%}
              {%- if hb_gift_badge_alt == blank -%}
                {%- assign hb_gift_badge_alt = product.title | append: ' gift badge' -%}
              {%- endif -%}
              <div class="hb-gift-badge">
                {{- hb_gift_badge | image_url: width: 132 | image_tag: loading: 'lazy', widths: '80,132,160,200', sizes: '132px', alt: hb_gift_badge_alt -}}
              </div>
            {%- endif -%}
            {%- render 'product-media', product: product, gallery_transition: 'fade' -%} 
            
            {% comment %} <div class="product-feature-tabs desktop-show">
              <div class="tabs-header">
                <ul>
                  {% if product.metafields.description.product_description.value != blank %}
                  <li class="tabs-slide active-border" data-target=".description-side"><span>Description</span></li>
                  {% endif %}
  
                  {% if product.metafields.features.product_features.value != blank %}
                  <li class="tabs-slide" data-target=".features-side"><span>Features</span></li>
                  {% endif %}
                </ul>
              </div>
              <div class="tab__content">
                {% if product.metafields.description.product_description.value != blank %}
                <div class="content__wrapper active-tab description-side">
                  {{ product.metafields.description.product_description.value }}
                </div>
                {% endif %}
    
                {% if product.metafields.features.product_features.value != blank %}
                <div class="content__wrapper features-side">
                  {{ product.metafields.features.product_features.value }}
                </div>
                {% endif %}
              </div>
            </div> {% endcomment %}
          </div>
          {%- render 'hb-product-info', product: product, update_url: true -%}
        </div>
      </div>
    </section>
  {%- else -%}
  
    {%- capture quick_buy_product_info -%}
      <div class="quick-buy-product">
        {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- assign quick_buy_image_alt = featured_media.alt | default: product.title -%}
  
        {%- if template.suffix == 'quick-buy-drawer' -%}
          {{- featured_media | image_url: width: featured_media.width | image_tag: loading: 'lazy', sizes: '114px', widths: '114,228,342', class: 'quick-buy-product__image', alt: quick_buy_image_alt -}}
        {%- else -%}
          {{- featured_media | image_url: width: featured_media.width | image_tag: loading: 'lazy', sizes: '65px', widths: '65,130,195', class: 'quick-buy-product__image', alt: quick_buy_image_alt -}}
        {%- endif -%}
  
        <div class="quick-buy-product__info {% if template.suffix == 'quick-buy-popover' %}text--small{% endif %}">
          <product-meta form-id="product-form-{{ section.id }}-{{ product.id }}" unit-price-class="text--xsmall" class="product-item-meta">
            {%- if section.settings.show_vendor -%}
              {%- assign vendor_handle = product.vendor | handle -%}
              {%- assign collection_for_vendor = collections[vendor_handle] -%}
  
              {%- unless collection_for_vendor.empty? -%}
                <a href="{{ collection_for_vendor.url }}" class="product-item-meta__vendor heading {% if template.suffix == 'quick-buy-drawer' %}heading--small{% else %}heading--xsmall{% endif %}">{{ product.vendor }}</a>
              {%- else -%}
                <a href="{{ product.vendor | url_for_vendor }}" class="product-item-meta__vendor heading {% if template.suffix == 'quick-buy-drawer' %}heading--small{% else %}heading--xsmall{% endif %}">{{ product.vendor }}</a>
              {%- endunless -%}
            {%- endif -%}
  
            <a href="{{ product.url }}" class="product-item-meta__title">{{ product.title }}</a>
  
            <div class="product-item-meta__price-list-container" role="region" aria-live="polite">
              <div class="price-list" data-product-price-list>
                {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                  <span class="price price--highlight">
                    <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
  
                    {%- if settings.currency_code_enabled -%}
                      {{- product.selected_or_first_available_variant.price | money_with_currency -}}
                    {%- else -%}
                      {{- product.selected_or_first_available_variant.price | money -}}
                    {%- endif -%}
                  </span>
  
                  <span class="price price--compare">
                    <span class="visually-hidden">{{ 'product.general.regular_price' | t }}</span>
  
                    {%- if settings.currency_code_enabled -%}
                      {{- product.selected_or_first_available_variant.compare_at_price | money_with_currency -}}
                    {%- else -%}
                        {% assign comprice = product.selected_or_first_available_variant.compare_at_price | money %}
{{ comprice | replace: ' ', '' }}
                      {{- comprice -}}
                    {%- endif -%}
                  </span>
                
                {%- else -%}
                  <span class="price">
                    <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
  
                    {%- if settings.currency_code_enabled -%}
                      {{- product.selected_or_first_available_variant.price | money_with_currency -}}
                    {%- else -%}
                      {{- product.selected_or_first_available_variant.price | money -}}
                    {%- endif -%}
                  </span>
                {%- endif -%}
  
                {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
                  <div class="price text--subdued text--xsmall">
                    <div class="unit-price-measurement">
                      <span class="unit-price-measurement__price">{{ product.selected_or_first_available_variant.unit_price | money }}</span>
                      <span class="unit-price-measurement__separator">/</span>
  
                      {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
                        <span class="unit-price-measurement__reference-value">{{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}</span>
                      {%- endif -%}
  
                      <span class="unit-price-measurement__reference-unit">{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}</span>
                    </div>
                  </div>
                {%- endif -%}
              </div>
  
              {%- if template.suffix == 'quick-buy-popover' -%}
                <a href="{{ product.url }}" class="link text--subdued">{{ 'product.general.view_details' | t }}</a>
              {%- endif -%}
            </div>
          </product-meta>
        </div>
      </div>
    {%- endcapture -%}
  
    {%- if template.suffix == 'quick-buy-drawer' -%}
      <quick-buy-drawer class="drawer drawer--large drawer--quick-buy">
        <cart-notification hidden class="cart-notification cart-notification--drawer"></cart-notification>
  
        <span class="drawer__overlay"></span>
  
        <header class="drawer__header">
          <p class="drawer__title heading h6">{{ 'product.form.choose_options' | t }}</p>
  
          <button type="button" class="drawer__close-button tap-area" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
            {%- render 'icon' with 'close' -%}
          </button>
        </header>
  
        <div class="drawer__content">
          {{- quick_buy_product_info -}}
          {%- render 'product-form', product: product -%}
        </div>
      </quick-buy-drawer>
    {%- elsif template.suffix == 'quick-buy-popover' -%}
      <quick-buy-popover class="popover popover--quick-buy">
        <span class="popover__overlay"></span>
  
        <header class="popover__header">
          {{- quick_buy_product_info -}}
  
          <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
            {%- render 'icon' with 'close' -%}
          </button>
        </header>
  
        <div class="popover__content popover__content--no-padding">
          {%- render 'product-form', product: product -%}
        </div>
      </quick-buy-popover>
    {%- endif -%}

    {% comment %} {%- if product != blank and section.settings.enable_review_structured_data -%}
      {%- assign rating_mf = product.metafields.reviews.rating.value -%}
      {%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- assign has_aggregate_rating = false -%}
      {%- if rating_mf != blank and review_count > 0 -%}
        {%- assign has_aggregate_rating = true -%}
        {%- assign rating_value = rating_mf.rating -%}
        {%- assign rating_min = rating_mf.scale_min | default: 1 -%}
        {%- assign rating_max = rating_mf.scale_max | default: 5 -%}
      {%- endif -%}

      {%- capture review_schema_items -%}
        {%- assign review_schema_first = true -%}

        {%- assign schema_reviews_list = product.metafields.custom.grillbot_reviews.value
          | default: product.metafields.custom.grillbot_reviews
          | default: product.metafields.custom.product_reviews.value
          | default: product.metafields.custom.product_reviews
        -%}
        {%- if schema_reviews_list != blank -%}
          {%- for rev in schema_reviews_list -%}
            {%- assign rev_body = rev.review.value | default: rev.review | default: rev.content.value | default: rev.content | default: rev.text.value | default: rev.text -%}
            {%- assign rev_author = rev.auth_name.value | default: rev.auth_name | default: rev.name.value | default: rev.name | default: rev.author.value | default: rev.author -%}
            {%- assign rev_rating = rev.rating.value | default: rev.rating | default: rev.stars.value | default: rev.stars | default: rev.star_rating.value | default: rev.star_rating -%}
            {%- if rev_body != blank -%}
              {%- capture rev_body_plain -%}{{ rev_body | metafield_tag | default: rev_body | strip_html | strip }}{%- endcapture -%}
              {%- if rev_body_plain != blank -%}
                {%- unless review_schema_first -%},{%- endunless -%}
                {%- assign review_schema_first = false -%}
                {
                  "@type": "Review",
                  "author": {
                    "@type": "Person",
                    "name": {{ rev_author | default: 'Customer' | json }}
                  },
                  "reviewBody": {{ rev_body_plain | json }}
                  {%- if rev_rating != blank -%}
                    {%- assign rev_rating_num = rev_rating | plus: 0 -%} 
                    {%- if rev_rating_num > 0 -%}
                      ,"reviewRating": {
                        "@type": "Rating", 
                        "ratingValue": {{ rev_rating_num | json }},
                        "bestRating": {{ rating_max | default: 5 | json }},
                        "worstRating": {{ rating_min | default: 1 | json }}
                      }  
                    {%- endif -%}
                  {%- endif -%}
                }
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- assign schema_review_mo = product.metafields.custom.grillbot_review_section.value
          | default: product.metafields.custom.grillbot_review.value
          | default: product.metafields.custom.main_review.value
        -%}
        {%- if schema_review_mo != blank -%}
          {%- assign rev_body = schema_review_mo.review.value | default: schema_review_mo.review | default: schema_review_mo.content.value | default: schema_review_mo.content -%}
          {%- assign rev_author = schema_review_mo.auth_name.value | default: schema_review_mo.auth_name | default: schema_review_mo.name.value | default: schema_review_mo.name -%}
          {%- assign rev_rating = schema_review_mo.rating.value | default: schema_review_mo.rating | default: schema_review_mo.star_rating.value | default: schema_review_mo.star_rating -%}
          {%- if rev_body != blank -%}
            {%- capture rev_body_plain -%}{{ rev_body | metafield_tag | default: rev_body | strip_html | strip }}{%- endcapture -%}
            {%- if rev_body_plain != blank -%}
              {%- unless review_schema_first -%},{%- endunless -%}
              {%- assign review_schema_first = false -%}
              {
                "@type": "Review",
                "author": {
                  "@type": "Person",
                  "name": {{ rev_author | default: 'Customer' | json }}
                },
                "reviewBody": {{ rev_body_plain | json }}
                {%- if rev_rating != blank -%}
                  {%- assign rev_rating_num = rev_rating | plus: 0 -%}
                  {%- if rev_rating_num > 0 -%}
                    ,"reviewRating": {
                      "@type": "Rating",
                      "ratingValue": {{ rev_rating_num | json }},
                      "bestRating": {{ rating_max | default: 5 | json }},
                      "worstRating": {{ rating_min | default: 1 | json }}
                    }
                  {%- elsif has_aggregate_rating -%}
                    ,"reviewRating": {
                      "@type": "Rating",
                      "ratingValue": {{ rating_value | json }},
                      "bestRating": {{ rating_max | json }},
                      "worstRating": {{ rating_min | json }}
                    }
                  {%- endif -%}
                {%- elsif has_aggregate_rating -%}
                  ,"reviewRating": {
                    "@type": "Rating",
                    "ratingValue": {{ rating_value | json }},
                    "bestRating": {{ rating_max | json }},
                    "worstRating": {{ rating_min | json }}
                  }
                {%- endif -%}
              }
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- if has_aggregate_rating or review_schema_items != blank -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "Product",
            "@id": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }},
            "url": {{ request.origin | append: product.url | json }}
            {%- if has_aggregate_rating -%}
              ,"aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ rating_value | json }},
                "reviewCount": {{ review_count | json }},
                "bestRating": {{ rating_max | json }},
                "worstRating": {{ rating_min | json }}
              }
            {%- endif -%}
            {%- if review_schema_items != blank -%}
              ,"review": [{{ review_schema_items }}]
            {%- endif -%}
          }
        </script>
      {%- endif -%}
    {%- endif -%} {% endcomment %}
  {%- endunless -%}
  
  {% schema %}
  {
    "name": "Product page",
    "class": "shopify-section--main-product",
    "blocks": [
      {
        "type": "@app"
      },
    
      {
        "type": "warranty_products",
        "name":"Warranty card",
        "limit":1,
        "settings":[
          {
            "type":"text",
            "label":"Heading",
            "id":"heading",
            "default":"Add Warranty"
          },
          {
            "type":"product_list",
            "label":"Product list",
            "id":"warranty_products_list"
          }
        ]
      },
      {
        "type": "additional_bundles",
        "name":"Additional Bundles",
        "limit":1,
        "settings":[
          {
            "type":"text",
            "label":"Heading",
            "id":"heading",
            "default":"Additional Bundles"
          },
          {
            "type":"product_list",
            "label":"Product list",
            "id":"additional_bundles_list"
          }
        ]
      },
      {
        "type": "variant_picker",
        "name": "Variant picker",
        "limit": 1,
        "settings": [
          {
            "type": "checkbox",
            "id": "hide_sold_out_variants",
            "label": "Hide sold out variants",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "hide_ultimate_bundle",
            "label": "Hide Ultimate Bundle",
            "default": false
          },
          {
            "type": "select",
            "id": "selector_mode",
            "label": "Selector type",
            "options": [
              {
                "value": "block",
                "label": "Block"
              },
              {
                "value": "dropdown",
                "label": "Dropdown"
              }
            ],
            "default": "block"
          },
          {
            "type": "select",
            "id": "color_mode",
            "label": "Color selector type",
            "info": "Variant image mode requires that all variant have an associated image. [Learn more](https://help.shopify.com/en/manual/products/product-media/add-images-variants#add-images-to-existing-variants)",
            "options": [
              {
                "value": "block",
                "label": "Block"
              },
              {
                "value": "dropdown",
                "label": "Dropdown"
              },
              {
                "value": "color",
                "label": "Color swatch"
              },
              {
                "value": "variant_image",
                "label": "Variant image"
              }
            ],
            "default": "color"
          },
          {
            "type": "page",
            "id": "size_chart_page",
            "label": "Size chart page",
            "info": "Feature a page for size option"
          }
        ]
      },
      {
        "type": "price_block",
        "name": "Price block",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Total Price"
          },
          {
            "type": "checkbox",
            "id": "show_notification",
            "label": "Show notification text",
            "default": true
          }
        ]
      },
      {
        "type": "main_icon_list",
        "name": "Main icon list",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Highlights"
          }
        ]
      },
      {
        "type": "quantity_selector",
        "name": "Quantity selector",
        "limit": 2,
        "settings": [
          {
            "type": "checkbox",
            "id": "show_price",
            "label": "Show Price",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "show_quantity",
            "label": "Show Quantity",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "show_description",
            "label": "Show Description",
            "default": false
          }
        ]
      },
      {
        "type": "buy_prime",
        "name": "Buy With Prime",
        "limit": 1,
        "settings": [
          {
            "type": "checkbox",
            "id": "show_prime_btn",
            "label": "Show Prime Button",
            "default": false
          }
        ]
      },
      {
        "type": "buy_buttons",
        "name": "Buy buttons",
        "limit": 1,
        "settings": [
          {
            "type": "checkbox",
            "id": "show_payment_button",
            "label": "Show dynamic checkout button",
            "info": "Each customer will see their preferred payment method from those available on your store, such as PayPal or Apple Pay. [Learn more](https://help.shopify.com/manual/using-themes/change-the-layout/dynamic-checkout)",
            "default": true
          },
          {
            "type": "color",
            "id": "atc_button_background",
            "label": "Add to cart background",
            "default": "rgba(0,0,0,0)"
          },
          {
            "type": "color",
            "id": "atc_button_text_color",
            "label": "Add to cart color",
            "default": "rgba(0,0,0,0)"
          },
          {
            "type": "color",
            "id": "buy_now_button_background",
            "label": "Buy now background",
            "default": "rgba(0,0,0,0)"
          },
          {
            "type": "color",
            "id": "buy_now_button_text_color",
            "label": "Buy now color",
            "default": "rgba(0,0,0,0)"
          }
        ]
      },
      {
        "type": "guarantee_box",
        "name": "Guarantee box",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Icon list"
          },
          {
            "type": "image_picker",
            "id": "item_1_icon",
            "label": "Item 1 icon"
          },
          {
            "type": "text",
            "id": "item_1_text",
            "label": "Item 1 text",
            "default": "60 Days Money-back guarantee"
          },
          {
            "type": "image_picker",
            "id": "item_2_icon",
            "label": "Item 2 icon"
          },
          {
            "type": "text",
            "id": "item_2_text",
            "label": "Item 2 text",
            "default": "Easy Returns"
          },
          {
            "type": "image_picker",
            "id": "item_3_icon",
            "label": "Item 3 icon"
          },
