{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}

<style>
  {%- assign text_position = section.settings.text_position | split: '_' | first -%}

  {%- case text_position -%}
    {%- when 'top' -%}
      {%- assign section_items_alignment = 'flex-start' -%}
    {%- when 'middle' -%}
      {%- assign section_items_alignment = 'center' -%}
    {%- when 'bottom' -%}
      {%- assign section_items_alignment = 'flex-end' -%}
  {%- endcase -%}

  #shopify-section-{{ section.id }} {
    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};

    --section-items-alignment: {{ section_items_alignment }};
    --section-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  .shopify--section-{{ section.id }} .pointer-slide .content {
    color: {{ section.settings.pointer_color }};
  }
  .shopify--section-{{ section.id }}.image-pointers-custom-wrapper .pointer-slide {
    background: {{ section.settings.pointer_bg }};
  }
  .video-tutorials-pointer-section.shopify--section-{{ section.id }} {
    position: relative;
  }
  .video-tutorials-pointer-section.shopify--section-{{ section.id }} .effect-smoke-box {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
  }
  .video-tutorials-pointer-section.shopify--section-{{ section.id }} .effect-smoke-box img {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media only screen and (max-width: 740px) {
    .video-tutorials-pointer-section.shopify--section-{{ section.id }} .effect-smoke-box {
      height: 50%;
    }
    .video-tutorials-pointer-section.shopify--section-{{ section.id }} .effect-smoke-box img {
      object-fit: cover;
    }
  }
  @media only screen and (min-width: 741px) {
    .image-overlay--extraLarge {
        --image-height: 900px;
    }
    .image-overlay--doubleXLarge {
        --image-height: 1100px;
    }
  }
</style>

<section class="section{% unless is_boxed %} section--flush{% endunless %} section-banner-rect image-pointers-custom-wrapper shopify--section-{{ section.id }} video-tutorials-pointer-section">
  <div {% if is_boxed %}class="container"{% endif %}>
    {%- assign image = section.settings.image -%}
    {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}

    <image-with-text-overlay {% if section.settings.reveal_on_scroll %}reveal-on-scroll{% endif %} class="image-overlay image-overlay--{{ section.settings.section_height }}" {% if section.settings.section_height == 'auto' %}style="--image-aspect-ratio: {{ image_aspect_ratio }}"{% endif %}>
      {% if section.settings.media_type == 'image' %}
      <div class="image-overlay__image-wrapper desktop-img" {% if section.settings.section_height == 'auto' %}style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"{% endif %}>
        {%- if image != blank -%}
          {%- if section.settings.reveal_on_scroll -%}
            {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', reveal: true, class: 'image-overlay__image' -}}
          {%- else -%}
            {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', class: 'image-overlay__image' -}}
          {%- endif -%}
        {%- else -%}
          {%- capture image_classes -%}image-overlay__image image-overlay__image--placeholder image-overlay__image--{{ section.settings.section_height }}{%- endcapture -%}

          {%- if section.settings.reveal_on_scroll -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes | replace: '<svg', '<svg reveal' -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes -}}
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- assign image_mobile = section.settings.image_mobile -%}
      <div class="image-overlay__image-wrapper mobile-img" {% if section.settings.section_height == 'auto' %}style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"{% endif %}>
        {%- if image_mobile != blank -%}
          {%- if section.settings.reveal_on_scroll -%}
            {{- image_mobile | image_url: width: image_mobile.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', class: 'image-overlay__image' -}}
          {%- else -%}
            {{- image_mobile | image_url: width: image_mobile.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', class: 'image-overlay__image' -}}
          {%- endif -%}
        {%- else -%}
          {%- capture image_classes -%}image-overlay__image image-overlay__image--placeholder image-overlay__image--{{ section.settings.section_height }}{%- endcapture -%}

          {%- if section.settings.reveal_on_scroll -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes | replace: '<svg', '<svg reveal' -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes -}}
          {%- endif -%}
        {%- endif -%}
      </div>
      
      {% elsif section.settings.media_type == 'video' %}
      <div class="image-overlay__image-wrapper" {% if section.settings.section_height == 'auto' %}style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"{% endif %}>
        {% if section.settings.video != blank %}
          <video class="mob_height" autoplay loop muted playsinline width="100%"
                 style="height:100%;
                 object-fit: {% if section.settings.video_sizing == 'contain' %}contain
                             {% elsif section.settings.video_sizing == 'cover' %}cover
                             {% elsif section.settings.video_sizing == 'fill' %}fill
                             {% elsif section.settings.video_sizing == 'original' %}scale-down{% endif %}">
            <source type="video/mp4" src="{{ section.settings.video }}">
          </video>
        {% endif %}
      </div>
      {% endif %}

      {%- capture section_content -%}
        {%- assign text_alignment = section.settings.text_position | split: '_' | last -%}

        <div class="image-overlay__content-wrapper">
          <div class="image-overlay__content content-box content-box--{{ section.settings.text_width }} content-box--text-{{ text_alignment }} content-box--{{ text_alignment }} text-container">
            
            {%- if section.settings.subheading != blank -%}
              <h2 class="heading heading--small sub-heading">
                <split-lines {% if section.settings.reveal_on_scroll %}reveal{% endif %}>{{ section.settings.subheading | escape }}</split-lines>
              </h2>
            {%- endif -%}

          </div>
        </div>
      {%- endcapture -%}

      <div {% if is_boxed %}style="width: 100%" class="pointers-box"{% else %}class="container pointers-box"{% endif %}>
        {{- section_content -}}
        
        <div class="product-quality-pointers">
          {% for block in section.blocks %}
            <div class="pointer-slide">
              <div class="pointer--mobile">
                <span class="pointer--dot">🔴</span>
                <div class="pointer-slide--wrapper">
                  <span class="close-point"><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/close_e22c071a-dfc0-4c6f-92fb-637576f9bbc7.svg?v=1682143957"/></span>
                  <div class="pointer-text">
                    {% if block.settings.img_text != blank %}
                      <div class="img-pointer">
                        <img src="{{ block.settings.img_text | img_url: '' }}"/>
                        {% if block.settings.pointer_text != blank %}
                          <p class="heading mobile-show">{{ block.settings.pointer_text }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                    <div class="content">
                      {% if block.settings.pointer_text != blank %}
                        <p class="heading desktop-show">{{ block.settings.pointer_text }}</p>
                      {% endif %}
                      {% if block.settings.text_1 != blank %}
                        <a class="pointer_link" href="{{ block.settings.link_1 }}"><span>{{ block.settings.text_1 }}</span><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_1_0b7a4549-d753-44e6-9b71-e1c0f825648f.svg?v=1683371695"/></a>
                      {% endif %}
                      {% if block.settings.text_2 != blank %}
                        <a class="pointer_link" href="{{ block.settings.link_2 }}"><span>{{ block.settings.text_2 }}</span><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_1_0b7a4549-d753-44e6-9b71-e1c0f825648f.svg?v=1683371695"/></a>
                      {% endif %}
                      {% if block.settings.text_3 != blank %}
                        <a class="pointer_link" href="{{ block.settings.link_3 }}"><span>{{ block.settings.text_3 }}</span><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_1_0b7a4549-d753-44e6-9b71-e1c0f825648f.svg?v=1683371695"/></a>
                      {% endif %}
                      {% if block.settings.text_4 != blank %}
                        <a class="pointer_link" href="{{ block.settings.link_4 }}"><span>{{ block.settings.text_4 }}</span><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_1_0b7a4549-d753-44e6-9b71-e1c0f825648f.svg?v=1683371695"/></a>
                      {% endif %}
                      {% if block.settings.text_5 != blank %}
                        <a class="pointer_link" href="{{ block.settings.link_5 }}"><span>{{ block.settings.text_5 }}</span><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_1_0b7a4549-d753-44e6-9b71-e1c0f825648f.svg?v=1683371695"/></a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>

          {% endfor %}
        </div>
      </div>
    </image-with-text-overlay>
  </div>
  {% if section.settings.animation_smoke != blank %}
    <div class="effect-smoke-box"><img src="{{ section.settings.animation_smoke | img_url: '' }}"/></div>
  {% endif %}
</section>

