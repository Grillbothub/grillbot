.pointer-slide--wrapper.show-this-point {
    display: block;
}
@media only screen and (max-width: 1199px) {
  .desktop-pointer {
    display: none;
  }
  .image-pointers-custom-wrapper span.pointer--dot {
    position: absolute;
    width: 20px;
    height: 20px;
    background: #ffffff;
    border-radius: 50px;
    color: #DE2A2C;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  .image-pointers-custom-wrapper .product-quality-pointers .pointer-slide {
    position: unset;
    padding: 0;
  }
  .image-pointers-custom-wrapper .pointer-slide:nth-child(1) span.pointer--dot {
    top: 36%;
    left: 38%;
  }
  .pointer-slide--wrapper {
    position: absolute;
    background: #ffffff;
    top: 63%;
    left: 50%;
    transform: translateX(-50%) translateY(-50%);
