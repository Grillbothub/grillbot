

<section class="gh" style="
  --gh-pt-desktop: {{ section.settings.padding_top_desktop }}px;
  --gh-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
  --gh-pt-mobile:  {{ section.settings.padding_top_mobile }}px;
  --gh-pb-mobile:  {{ section.settings.padding_bottom_mobile }}px;
">
  <div class="gh__inner">

    {%- comment -%} ── LEFT: Media ── {%- endcomment -%}
    <div class="gh__media">
      {% if section.settings.media_image != blank %}
        <img
          class="gh__img"
          src="{{ section.settings.media_image | image_url: width: 800 }}"
          alt="{{ section.settings.heading_plain }}"
          loading="eager"
          width="800"
          height="600"
        >
      {% else %}
        <div class="gh__img gh__img--placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    {%- comment -%} ── RIGHT: Content ── {%- endcomment -%}
    <div class="gh__content">

      {%- comment -%} Eyebrow {%- endcomment -%}
      {% if section.settings.eyebrow != blank %}
        <p class="gh__eyebrow">
          <span class="gh__eyebrow-icon">
           <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
  <path d="M12 21V12M12 7H7.95001C5.18001 7 5.01001 3 7.95001 3C11.1 3 12 7 12 7ZM12 7H16.05C18.946 7 18.946 3 16.05 3C12.9 3 12 7 12 7Z" stroke="#B6D22F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M20 12V19C20 19.5304 19.7893 20.0391 19.4142 20.4142C19.0391 20.7893 18.5304 21 18 21H6C5.46957 21 4.96086 20.7893 4.58579 20.4142C4.21071 20.0391 4 19.5304 4 19V12M21 12V9C21 8.46957 20.7893 7.96086 20.4142 7.58579C20.0391 7.21071 19.5304 7 19 7H5C4.46957 7 3.96086 7.21071 3.58579 7.58579C3.21071 7.96086 3 8.46957 3 9V12H21Z" stroke="#B6D22F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
          </span>
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {%- comment -%} Heading: plain + highlighted + plain_after {%- endcomment -%}
      <h2 class="gh__heading">
        {{ section.settings.heading_before }}
        {% if section.settings.heading_highlight != blank %}
          <span class="gh__highlight">{{ section.settings.heading_highlight }}</span>
        {% endif %}
        {{ section.settings.heading_after }}
      </h2>

      {%- comment -%} Subheading {%- endcomment -%}
      {% if section.settings.subheading != blank %}
        <p class="gh__sub">{{ section.settings.subheading }}</p>
      {% endif %}

      {%- comment -%} Review Card {%- endcomment -%}
      {% if section.settings.review_text != blank %}
        <div class="gh__review">
          <div class="gh__stars">
         
            {% for i in (1..5) %}
             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
  <path d="M6.56829 11.0895C6.79074 10.9552 7.06926 10.9552 7.29171 11.0895L9.79244 12.5988C10.3226 12.9188 10.9765 12.4435 10.8359 11.8405L10.1722 8.99573C10.1132 8.74269 10.1992 8.47776 10.3956 8.30762L12.606 6.3927C13.074 5.98726 12.8239 5.21848 12.2069 5.16613L9.29794 4.91934C9.03923 4.89739 8.81393 4.73405 8.71261 4.495L7.5745 1.80972C7.33329 1.2406 6.52671 1.2406 6.2855 1.80972L5.14739 4.495C5.04608 4.73405 4.82077 4.89739 4.56207 4.91934L1.65314 5.16613C1.03614 5.21848 0.785958 5.98726 1.25398 6.3927L3.46444 8.30762C3.66083 8.47776 3.74682 8.74269 3.68779 8.99573L3.02415 11.8405C2.88348 12.4435 3.53744 12.9188 4.06756 12.5988L6.56829 11.0895Z" fill="#FFAF2E"/>
</svg>
            {% endfor %}
          </div>
          <p class="gh__review-text">"{{ section.settings.review_text }}"</p>
          {% if section.settings.review_author != blank %}
            <p class="gh__review-author">— {{ section.settings.review_author }}</p>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} Feature Icons Row (blocks) {%- endcomment -%}
      {% if section.blocks.size > 0 %}
        <div class="gh__features">
          {% for block in section.blocks %}
            <div class="gh__feature" {{ block.shopify_attributes }}>
              <div class="gh__feature-icon">
                {% if block.settings.icon != blank %}
                  <img
                    src="{{ block.settings.icon | image_url: width: 60 }}"
                    alt="{{ block.settings.label }}"
                    width="28"
                    height="28"
                    loading="lazy"
                  >
                {% else %}
                  {%- comment -%} Default SVG fallbacks per index {%- endcomment -%}
                  {% case forloop.index %}
                    {% when 1 %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    {% when 2 %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {% when 3 %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                    {% when 4 %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                  {% endcase %}
                {% endif %}
              </div>
              {% if block.settings.label != blank %}
                <p class="gh__feature-label">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} CTA Button {%- endcomment -%}
      {% if section.settings.button_label != blank %}
        <a class="gh__btn" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .gh {
    background-color: #000;
    padding-top: var(--gh-pt-desktop);
    padding-bottom: var(--gh-pb-desktop);
  }

  .gh__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
   
    gap: 40px;
    align-items: center;
  }

  /* ── Left Media ── */
  .gh__media {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio:1/1;
    background-color: #1a1a1a;
    max-width:40%;
    width:100%;
  }

  .gh__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gh__img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gh__img--placeholder .placeholder-svg {
    width: 80px;
    height: 80px;
    fill: #444;
  }

  /* ── Right Content ── */
.gh__content {
    display: flex;
    flex-direction: column;
   
    max-width: 60%;
    width: 100%;
}

  /* Eyebrow */
  .gh__eyebrow {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: var(--green, #B6D22F);
text-align: center;
font-family: Rubik;
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: 26px; /* 185.714% */
text-transform: uppercase;
  }

  .gh__eyebrow-icon {
    display: flex;
    align-items: center;
    color: #AAFF00;
  }

  /* Heading */
  .gh__heading {
      letter-spacing: 0.01em;
    color: #FFF;
    font-family: Anton !important;
    font-size: 52px;
    font-style: normal;
    font-weight: 400;
    line-height: 60px;
    text-transform: uppercase;
    margin: 0;
    margin-top:4px;
    margin-bottom:14px;
   
  }

  .gh__highlight {
    color: #B6D22F;
  }

  /* Subheading */
  .gh__sub {
   color: var(--white, #FFF);
font-family: Rubik;
font-size: 20px;
font-style: normal;
font-weight: 400;
line-height: 30px; /* 150% */
margin:0px;
  }

  /* ── Review Card ── */
.gh__review {
    background-color: #1c1c1c;
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.13);
    display: flex;
    padding: 24px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    align-self: stretch;
    margin-top:24px;
    margin-bottom:24px;
}
  .gh__stars {
    display: flex;
    gap: 2px;
  }

  .gh__star {
    font-size: 18px;
    color: #444;
  }

  .gh__star--filled {
    color: #AAFF00;
  }

.gh__review-text {
    font-size: 14px;
    color: #dddddd;
    margin: 0;
    line-height: 1.6;
    font-style: italic;
    color: var(--white, #FFF);
    font-family: Rubik;
    font-size: 20px;
    font-style: italic;
    font-weight: 300;
    line-height: 26px;
}
  .gh__review-author {
    font-size: 13px;
    font-weight: 600;
    color: #aaaaaa;
    margin: 0;
    color: var(--white, #FFF);
font-family: Rubik;
font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 30px; /* 166.667% */
  }

  /* ── Feature Icons Row ── */
  .gh__features {
    display: flex;
    flex-direction: row;
    gap: 12px;
    flex-wrap: wrap;
  }
.gh__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 70px;
    text-align: center;
}

  .gh__feature-icon {
    width: 32px;
    
  }

  .gh__feature-icon img {
    width: 32px;
   height:auto;
  }

  .gh__feature-label {
    font-size: 12px;
    font-weight: 600;
    color: #cccccc;
    margin: 0;
    line-height: 1.3;
    color: var(--white, #FFF);
font-family: Rubik;
font-size: 20px;
font-style: normal;
font-weight: 400;
line-height: 30px; /* 150% */
  }

  /* ── CTA Button ── */
 a.gh__btn {
    display: flex;
    width: 286px;
    height: 56px;
    padding: 16px 32px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 100px;
    background: #B6D22F;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    margin-top:32px;
    line-height: 22px;
}

  .gh__btn:hover {
    opacity: 0.85;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 768px) {
    .gh {
      padding-top: var(--gh-pt-mobile);
      padding-bottom: var(--gh-pb-mobile);
    }

    .gh__inner {
      padding:0px 16px;
      flex-wrap:wrap;
      gap:40px;
    }

    .gh__media {
    
    max-width: 100%;
}
.gh__content {
   max-width:100%;
}

.gh__heading {
    letter-spacing: 0.01em;
    color: #FFF;
    font-family: Anton !important;
    font-size: 36px;
    font-style: normal;
    font-weight: 400;
    line-height: 44px;
    text-transform: uppercase;
    margin: 0;
    margin-top: 4px;
    margin-bottom: 14px;
}
.gh__sub {
    color: var(--white, #FFF);
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    margin: 0px;
}
.gh__review {
    background-color: #1c1c1c;
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.13);
    display: flex;
    padding: 16px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    align-self: stretch;
    margin-top: 24px;
    margin-bottom: 24px;
}
.gh__review-text {
    font-size: 14px;
    color: #dddddd;
    margin: 0;
    line-height: 1.6;
    font-style: italic;
    color: var(--white, #FFF);
    font-family: Rubik;
    font-size: 16px;
    font-style: italic;
    font-weight: 300;
    line-height: 24px;
}
.gh__review-author {
    font-size: 13px;
    font-weight: 600;
    color: #aaaaaa;
    margin: 0;
    color: var(--white, #FFF);
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 30px;
}
.gh__feature-label {
    font-size: 12px;
    font-weight: 600;
    color: #cccccc;
    margin: 0;
    line-height: 1.3;
    color: var(--white, #FFF);
    font-family: Rubik;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 26px;
}
.gh__features {
    display: flex;
    flex-direction: row;
    gap: 12px;
    flex-wrap: wrap;
    column-gap: 0px;
    row-gap: 16px;
}
.gh__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 70px;
    text-align: center;
    min-width: 50%;
}
a.gh__btn {
   
    width: 100%;
}

  }
</style>

{% schema %}
{
  "name": "Gift Hero",
  "tag": "section",
  "class": "gift-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Left Image"
    },
    {
      "type": "header",
      "content": "Eyebrow & Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Perfect Gift for BBQ Lovers"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading — Text Before Highlight",
      "default": "The Gift Every "
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading — Highlighted Word(s)",
      "default": "Grill Lover"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading — Text After Highlight",
      "default": " Wants"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Give them less scrubbing and more time enjoying the moment."
    },
    {
      "type": "header",
      "content": "Review Card"
    },
    {
      "type": "range",
      "id": "review_stars",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review Text",
      "default": "Bought this for my husband and now he uses it every single cookout. Honestly one of the best BBQ gifts I've found."
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Reviewer Name",
      "default": "Amanda S."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Gifts →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Hero",
      "blocks": [
        {
          "type": "feature",
          "settings": { "label": "Actually useful" }
        },
        {
          "type": "feature",
          "settings": { "label": "Fun to use" }
        },
        {
          "type": "feature",
          "settings": { "label": "Perfect for dads & BBQ lovers" }
        },
        {
          "type": "feature",
          "settings": { "label": "Ready to gift" }
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
