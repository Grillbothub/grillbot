{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}
<style>
section.custom--product-types.shopify-section--{{ section.id }} .text-color {
  color: {{ section.settings.text_color }};
}
{% if section.settings.out_spacing %}
section.youtube-text--section.shopify-section--{{ section.id }} {
  margin: 0 !important;
}
{% endif %}

section.youtube-text--section.shopify-section--{{ section.id }} .text__alignment {
  text-align: {% if section.settings.heading_alignment == 'left' %}left
              {% elsif section.settings.heading_alignment == 'center' %}center
              {% elsif section.settings.heading_alignment == 'right' %}right{% endif %};
}
section.youtube-text--section.shopify-section--{{ section.id }} .heading-apart h2.heading {
    font-weight: 900;
    font-size: 63px;
    line-height: 78px;
    margin-bottom: 20px !important;
}
section.youtube-text--section.shopify-section--{{ section.id }} .content-apart .content p {
    font-size: 22px;
    line-height: 30px;
    font-weight: 300;
    margin: 12px 0;
}
section.youtube-text--section.shopify-section--{{ section.id }} .subheading-apart h3.heading {
    font-weight: 900;
    font-size: 33px;
    line-height: 41px;
    margin-bottom: 20px !important;
}
section.youtube-text--section.shopify-section--{{ section.id }} .iframe-embeded {
    padding-top: 40px;
    padding-bottom: 20px;
}
section.youtube-text--section.shopify-section--{{ section.id }} .youtube-video-with-text .points-apart {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
    justify-content: {% if section.settings.heading_alignment == 'left' %}left
                     {% elsif section.settings.heading_alignment == 'center' %}center
                     {% elsif section.settings.heading_alignment == 'right' %}right{% endif %};
}
section.youtube-text--section.shopify-section--{{ section.id }} .points-apart .single_tab_area {
    padding: 0 10px;
}
section.youtube-text--section.shopify-section--{{ section.id }} .points-apart .single_tab_area span {
    font-size: 12px;
    line-height: 25px;
    text-transform: uppercase;
}
.custom--product-types .error-apart {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    {% if section.settings.heading_alignment == 'left' %}
      margin-right: auto;
    {% elsif section.settings.heading_alignment == 'center' %}
      margin: auto;
    {% elsif section.settings.heading_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
    padding: 10px 15px;
    background: #DE2A2C1A;
    border-radius: 10px;
    margin-bottom: 20px;
}
.custom--product-types .error-apart p {
    margin: 0;
    font-size: 18px;
    line-height: 24px;
    color: #DE2A2C;
    font-weight: 500;
}
.custom--product-types .product-types-custom {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
}
.custom--product-types .product-types-custom .pr_type_tabs {
    background: #FFFFFF;
    box-shadow: 0px 35px 60px rgba(0, 0, 0, 0.05);
    padding: 30px 40px;
}
.custom--product-types .product-types-custom .pr_type_tabs .image-ratio img {
    display: block;
    width: 100%;
}
.custom--product-types .product-types-custom .pr_type_tabs .image-ratio {
    max-width: 350px;
    margin: auto;
}
.custom--product-types .product-types-custom .pr_type_tabs .text-image-box {
    position: relative;
    padding-bottom: 60px;
    height: 100%;
    text-align: center;
}
.custom--product-types .pr_type_tabs .text-image-box .heading-type p {
    font-size: 22px;
    line-height: 34px;
    font-weight: 600;
    margin-top: 10px !important;
}
.custom--product-types .pr_type_tabs .text-image-box .content p {
    font-weight: 300;
    font-size: 16px;
    line-height: 30px;
}
.custom--product-types .pr_type_tabs .text-image-box .content {
    margin-top: 10px !important;
}
.custom--product-types .product-types-custom .pr_type_tabs .text-image-box .button {
    border-bottom: 2px solid #b6d22f;
}
.custom--product-types .product-types-custom .pr_type_tabs .text-image-box .button a {
    font-size: 14px;
    line-height: 31px;
    text-align: center;
    letter-spacing: 0.04em;
    white-space: nowrap;
}
.custom--product-types .product-types-custom .pr_type_tabs .text-image-box .button {
    border-bottom: 2px solid #b6d22f;
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: center;
    width: fit-content;
    margin: auto;
    min-height: 51px;
    padding: 0 20px;
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
}
.custom--product-types .pr-tab-field-wrapper {
    margin-top: 40px;
    margin-bottom: 40px;
}
.custom--product-types .sale-percentage-badge span {
    font-size: 18px;
    line-height: 31px;
    text-align: center;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    color: #000000;
    background: #b6d22f;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 25px auto 0;
    padding: 0 20px;
    position: relative;
}
.custom--product-types .sale-percentage-badge span::before {
    content: '';
    width: 0;
    height: 0;
    border-top: 26px solid transparent;
    border-left: 10px solid #ffffff;
    border-bottom: 25px solid transparent;
    position: absolute;
    top: -1px;
    left: 0px;
    z-index: 9;
}
.custom--product-types .sale-percentage-badge span::after {
    content: '';
    width: 0;
    height: 0;
    border-top: 26px solid transparent;
    border-right: 10px solid #ffffff;
    border-bottom: 25px solid transparent;
    position: absolute;
    top: -1px;
    right: 0px;
    z-index: 9;
}
  .steps-apart {
    margin-top: 40px;
    margin-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
}
  .step-apart {
    width: 25%;
    padding: 10px;
}
  .image_with_list-apart {
    margin-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
}
  .image_with_list-apart-left {
    width: 60%;
    padding-right: 20px;
}
  
.image_with_list-apart-right {
    width: 40%;
}
  .image_with_list-apart-left ul {
    padding: 0;
    list-style: none;
}
  .image_with_list-apart-left ul li {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    font-weight: bold;
}
  .image_with_list-apart-left ul li img {
    margin-right: 10px;
}
  .product_list-apart .product-list__inner {
    grid-template-columns: repeat(auto-fit,calc(100% / 3 - 25px * (3 - 1) / 3));
}
@media only screen and (max-width: 1000px) {
  .custom--product-types .product-types-custom {
    gap: 20px;
  }
  .custom--product-types .product-types-custom .pr_type_tabs {
    padding: 15px 15px 30px;
  }
}
@media only screen and (max-width: 740px) {
  section.custom--product-types.shopify-section--{{ section.id }} .heading-apart h2.heading {
    font-size: 39px;
    line-height: 48px;
    margin-bottom: 10px !important;
  }
  section.custom--product-types.shopify-section--{{ section.id }} .content-apart .content p {
    font-size: 20px;
    line-height: 30px;
  }
  section.custom--product-types.shopify-section--{{ section.id }} .iframe-embeded {
    padding-top: 20px;
  }
  section.custom--product-types.shopify-section--{{ section.id }} .youtube-video-with-text .points-apart {
    display: none;
  }
  section.custom--product-types.shopify-section--{{ section.id }} .subheading-apart h3.heading {
    font-size: 25px;
    line-height: 31px;
    margin-bottom: 10px !important;
    margin-top: 20px !important;
  }
  section.custom--product-types.shopify-section--{{ section.id }} {
    padding-top: 0 !important;
  }
  .custom--product-types .error-apart {
    align-items: start;
  }
  .custom--product-types .product-types-custom {
    grid-template-columns: repeat(1, 1fr);
    gap: 30px;
  }
  .custom--product-types .product-types-custom .pr_type_tabs {
    padding: 10px 15px 30px;
  }
  .custom--product-types .product-types-custom .pr_type_tabs .text-image-box .button {
    width: 100%;
    max-width: 400px;
  }
  .step-apart {
    width: 50%;
}
}

</style>

<section class="section{% unless is_boxed %} section--flush{% endunless %} youtube-text--section custom--product-types shopify-section--{{ section.id }} {{ section.settings.custom_class }}"
          style="background: {{ section.settings.bg_color_all }};
                 padding-top: {{ section.settings.padding_top }}px;
                 padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% if block.settings.enable_left_sticks and block.settings.left_sticks != blank %}
    <div class="enable_left_sticks" data-aos="fade-right"><img src="{{ block.settings.left_sticks | img_url: '' }}"></div>
  {% endif %}
  <div {% if is_boxed %}class="container"{% endif %}>
    <div class="product-guide-tutorials products-guide-tutorials" data-identifier="{{ section.settings.identifier }}">
      <div class="youtube-video-with-text">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% case block.type %}
            <div class="text-field-wrapper">
              {% when 'heading' %}
                {% if block.settings.heading != blank %}
                <div class="heading-apart">
                  <h2 class="heading h2 text-color text__alignment">{{ block.settings.heading }}</h2>
                </div>
                {% endif %}
  
              {% when 'points' %}
                <div class="points-apart">
                  {% for i in (1..5) %}
                    {% assign key_link = 'key_link_' | append: i %}
                    {% assign svg_text_key = 'svg_text_' | append: i %}
                    {% if block.settings[svg_text_key] != blank %}
                      <div class="single_tab_area">
                        {% if block.settings[key_link] != blank %}
                        <a href="{{ block.settings[key_link] }}" class="points_link">
                        {% endif %}
                          <span>{{ block.settings[svg_text_key] }}</span>
                        {% if block.settings[key_link] != blank %}
                        </a>
                        {% endif %}
                      </div>
                      <style>
                        section.youtube-text--section.shopify-section--{{ section.id }} .points-apart .single_tab_area span {
                          color: {{ block.settings.point_color }};
                        }
                        section.youtube-text--section.shopify-section--{{ section.id }} .points-apart .single_tab_area {
                          border: 1px solid {{ block.settings.point_color }};
                        }
                      </style>
                    {% endif %}
                  {% endfor %}
                </div>
              {% when 'steps' %}
              <div class="steps-apart">
              {% for i in (1..10) %}
                {% assign step_image = 'step_image_' | append : i %}
                {% assign step_heading = 'step_heading_' | append : i %}
                {% assign step_content = 'step_content_' | append : i %}
                {% if block.settings[step_image] != blank %}
                  <div class="step-apart">
                    {% if block.settings[step_image] != blank %}
                      <div class="image-ratio"><img src="{{ block.settings[step_image] | img_url: '' }}"/></div>
                    {% endif %}
                    {% if block.settings[step_heading] != blank %}
                      <div class="heading-type"><strong>{{ block.settings[step_heading] }}</strong></div>
                    {% endif %}
                    {% if block.settings[step_content] != blank %}
                      <div class="content">{{ block.settings[step_content] }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
              </div>
  
              {% when 'subheading' %}
                {% if block.settings.sub_heading != blank %}
                <div class="subheading-apart">
                  <h3 class="heading h3 text-color text__alignment">{{ block.settings.sub_heading }}</h3>
                </div>
                {% endif %}
  
              {% when 'error' %}
                {% if block.settings.error != blank %}
                <div class="error-apart">
                  <img src="https://cdn.shopify.com/s/files/1/0337/8629/files/info.svg?v=1682399514"/>
                  <p class="error text__alignment">{{ block.settings.error }}</p>
                </div>
                {% endif %}
              
              {% when 'content' %}
                {% if block.settings.content != blank %}
                <div class="content-apart">
                  <div class="content text-color text__alignment">{{ block.settings.content }}</div>
                </div>
                {% endif %}
              {% when 'video' %}
              <div class="video-field-wrapper">
                <div class="iframe-embeded">
                  {% if block.settings.video_type == 'video' %}
                    {% if block.settings.video != blank %}
                    <video class="mob_height" autoplay loop muted width="100%" height="{{ block.settings.youtube_height }}">
                      <source type="video/mp4" src="{{ block.settings.video }}">
                    </video>
                    {% endif %}
                  {% elsif block.settings.video_type == 'youtube' %}
                    {% if block.settings.iframe != blank %}
                    <iframe class="mob_height" width="100%" height="{{ block.settings.youtube_height }}" src="{{ block.settings.iframe }}" allow="autoplay" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen allowtransparency></iframe>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
              {% when 'product_types' %}
                <div class="pr-tab-field-wrapper">
                  <div class="product-types-custom">
                    {% for i in (1..4) %}
                      {% assign image = 'image_' | append : i %}
                      {% assign heading = 'heading_' | append : i %}
                      {% assign content = 'content_' | append : i %}
                      {% assign sale_badge = 'sale_badge_' | append : i %}
                      {% assign label = 'label_' | append : i %}
                      {% assign link = 'link_' | append : i %}
                      {% if block.settings[image] != blank %}
                      <div class="pr_type_tabs">
                        <div class="text-image-box">
                          {% if block.settings[image] != blank %}
                            <div class="image-ratio"><img src="{{ block.settings[image] | img_url: '' }}"/></div>
                          {% endif %}
                          {% if block.settings[heading] != blank %}
                            <div class="heading-type"><p>{{ block.settings[heading] }}</p></div>
                          {% endif %}
                          {% if block.settings[content] != blank %}
                            <div class="content">{{ block.settings[content] }}</div>
                          {% endif %}
                          {% if block.settings[sale_badge] != blank %}
                            <div class="sale-percentage-badge"><span>{{ block.settings[sale_badge] }}</span></div>
                          {% endif %}
                          {% if block.settings[label] != blank %}
                            <div class="button">
                              <a href="{{ block.settings[link] }}">{{ block.settings[label] }}</a>
                              <img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Vector_30_2.svg?v=1682402070"/>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% when 'image_with_list' %}
               <div class="image_with_list-apart">
                 {% if block.settings.show_points %}
                 <div class="image_with_list-apart-left">
                    <ul>
                    {% for i in (1..5) %}
                      {% assign list_item = 'list_item_' | append : i %}
                      {% if block.settings[list_item] != blank %}
                        <li><img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Group_134_1.svg?v=1683548886">{{ block.settings[list_item] }}</li>
                      {% endif %}
                    {% endfor %}
                    </ul>
                 </div>
                 {% endif %}
                 {% if block.settings.show_image %}
                 <div class="image_with_list-apart-right">
                   {% if block.settings.right_image != blank %}
                     <img src="{{ block.settings.right_image | img_url : 'master' }}">
                   {% endif %}
                 </div>
                 {% endif %}
               </div>
              {% when 'product_list' %}
              <div class="product_list-apart">
                <product-list class="product-list">
                  <div class="product-list__inner">
                    {% for i in (1..5) %}
                      {% assign product = 'product_' | append : i %}
                      {% if block.settings[product] != '' %}
                        {% assign product = block.settings[product] %}
                         {%- render 'product-item', product: product -%}
                      {% endif %}
                    {% endfor %}
                  </div>
                </product-list>
              </div>
            {% endcase %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
    </div>
  </div>
  {% if block.settings.enable_right_sticks and block.settings.right_sticks != blank %}
    <div class="enable_right_sticks" data-aos="fade-left"><img src="{{ block.settings.right_sticks | img_url:'' }}"></div>
  {% endif %}
</section>

<style>
@media only screen and (max-width: 1200px) {
  .youtube-text--section.shopify-section--{{ section.id }} .mob_height {
    height: 800px !important;
  }
}
@media only screen and (max-width: 740px) {
  .youtube-text--section.shopify-section--{{ section.id }} .mob_height {
    height: 300px !important;
  }
}
</style>
{% schema %}
