{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}

<style>
  {%- assign text_position = section.settings.text_position | split: '_' | first -%}

  {%- case text_position -%}
    {%- when 'top' -%}
      {%- assign section_items_alignment = 'flex-start' -%}
    {%- when 'middle' -%}
      {%- assign section_items_alignment = 'center' -%}
    {%- when 'bottom' -%}
      {%- assign section_items_alignment = 'flex-end' -%}
  {%- endcase -%}

  #shopify-section-{{ section.id }} {
    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};

    --section-items-alignment: {{ section_items_alignment }};
    --section-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  
  @media only screen and (min-width: 741px) {
    .image-overlay--extraLarge {
        --image-height: 900px;
    }
    .image-overlay--doubleXLarge {
        --image-height: 1100px;
    }

    .shopify-section--{{ section.id }}.section-banner-rect .image-overlay__content-wrapper .image-overlay__content {
      text-align: {% if section.settings.text_align_desktop == 'left' %}left
                  {% elsif section.settings.text_align_desktop == 'center' %}center
                  {% elsif section.settings.text_align_desktop == 'right' %}right{% endif %};
    }
    .shopify-section--{{ section.id }}.section-banner-rect .hero-badge-banner {
      {% if section.settings.text_align_desktop == 'left' %}margin-right: auto;
      {% elsif section.settings.text_align_desktop == 'center' %}margin: auto;
      {% elsif section.settings.text_align_desktop == 'right' %}margin-left: auto;{% endif %}
    }
    .shopify-section--{{ section.id }}.section-banner-rect .content-box--fill .image-overlay__text-container {
      {% if section.settings.text_align_desktop == 'right' %}flex-direction: row;
      {% elsif section.settings.text_align_desktop == 'left' %}flex-direction: row-reverse;
      {% elsif section.settings.text_align_desktop == 'center' %}flex-direction: row-reverse; justify-content: center; gap: 40px;{% endif %}
    }
    .shopify-section--{{ section.id }}.section-banner-rect .button-wrapper {
      {% if section.settings.text_align_desktop == 'right' %}justify-content: space-between;
      {% elsif section.settings.text_align_desktop == 'left' %}justify-content: space-between;
      {% elsif section.settings.text_align_desktop == 'center' %}justify-content: center;{% endif %}
    }
  }
  @media only screen and (max-width: 740px) {
    .shopify-section--{{ section.id }}.section-banner-rect .image-overlay__content-wrapper .image-overlay__content {
      text-align: {% if section.settings.text_align_mobile == 'left' %}left
                  {% elsif section.settings.text_align_mobile == 'center' %}center
                  {% elsif section.settings.text_align_mobile == 'right' %}right{% endif %}
    }
  }
  .shopify-section--{{ section.id }}.section-banner-rect {
    position: relative;
  }
</style>

<section class="section{% unless is_boxed %} section--flush{% endunless %} section-banner-rect shopify-section--{{ section.id }} {{ section.settings.custom_class }}">
  <div {% if is_boxed %}class="container"{% endif %}>
    {%- assign image = section.settings.image -%}
    {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}

    <image-with-text-overlay {% if section.settings.reveal_on_scroll %}reveal-on-scroll{% endif %} class="image-overlay image-overlay--{{ section.settings.section_height }}" {% if section.settings.section_height == 'auto' %}style="--image-aspect-ratio: {{ image_aspect_ratio }}"{% endif %}>
      {% if section.settings.media_type == 'image' %}
      <div class="image-overlay__image-wrapper" {% if section.settings.section_height == 'auto' %}style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"{% endif %}>
        {%- if image != blank -%}
          {%- if section.settings.reveal_on_scroll -%}
            {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', reveal: true, class: 'image-overlay__image' -}}
          {%- else -%}
            {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000', class: 'image-overlay__image' -}}
          {%- endif -%}
        {%- else -%}
          {%- capture image_classes -%}image-overlay__image image-overlay__image--placeholder image-overlay__image--{{ section.settings.section_height }}{%- endcapture -%}

          {%- if section.settings.reveal_on_scroll -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes | replace: '<svg', '<svg reveal' -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag: image_classes -}}
          {%- endif -%}
        {%- endif -%}
      </div>
      {% elsif section.settings.media_type == 'video' %}
      <div class="image-overlay__image-wrapper" {% if section.settings.section_height == 'auto' %}style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"{% endif %}>
        {% if section.settings.video != blank %}
          <video class="mob_height" autoplay loop muted playsinline width="100%" 
                 style="height:100%; 
                 object-fit: {% if section.settings.video_sizing == 'contain' %}contain
                             {% elsif section.settings.video_sizing == 'cover' %}cover
                             {% elsif section.settings.video_sizing == 'fill' %}fill
                             {% elsif section.settings.video_sizing == 'original' %}scale-down{% endif %}">
            <source type="video/mp4" src="{{ section.settings.video }}">
          </video>
        {% endif %}
      </div>
      {% endif %}

      {%- capture section_content -%}
        {%- assign text_alignment = section.settings.text_position | split: '_' | last -%}

        <div class="image-overlay__content-wrapper">
          
          <div class="image-overlay__content content-box content-box--{{ section.settings.text_width }} content-box--text-{{ text_alignment }} content-box--{{ text_alignment }} text-container">
   
              
        {% if section.settings.banner_badge != blank %}
              <div class="hero-badge-banner">
                <img class="background-bg-image" src="https://cdn.shopify.com/s/files/1/0337/8629/files/Rectangle_153_1.png?v=1681196608">
                <img src="{{ section.settings.badge_image | img_url: '' }}"/>
                <p class="text">{{ section.settings.banner_badge }}</p>
              </div>
            {% endif %}
            {%- if section.settings.subheading != blank -%}
              <h2 class="heading heading--small sub-heading">
                <split-lines {% if section.settings.reveal_on_scroll %}reveal{% endif %}>{{ section.settings.subheading | escape }}</split-lines>
              </h2>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <h3 class="heading h2">
                <split-lines {% if section.settings.reveal_on_scroll %}reveal{% endif %}>{{ section.settings.title | escape }}</split-lines>
              </h3>
            {%- endif -%}

            {%- if section.settings.heading_two != blank -%}
              <h4 class="heading h4 small-size_heading">
                <span>{{ section.settings.heading_two }}</span>
              </h4>
            {%- endif -%}

            {%- if section.settings.content != blank or section.settings.button_text != blank -%}
              <div class="image-overlay__text-container" {% if section.settings.reveal_on_scroll %}reveal{% endif %}>
                {%- if section.settings.content != blank-%}
                  {{- section.settings.content -}}
                {%- endif -%}

                {%- if section.settings.button_text != blank -%}
                  {%- if section.settings.link_style == 'link' -%}
                    <a href="{{ section.settings.button_link }}" class="multi-column__link heading heading--small link">{{ section.settings.button_text | escape }}</a>
                    {% if section.settings.ext_btn_link != blank %}
                      <a href="{{ section.settings.ext_btn_link }}" class="multi-column__link heading heading--small link"><img src="{{ section.settings.img_ext | img_url: '' }}"/></a>
                    {% endif %}
                  {%- else -%}
                    <div class="button-wrapper">
                      <a href="{{ section.settings.button_link }}" class="button button--primary" style="background: {{ section.settings.button_bg }};">{{ section.settings.button_text | escape }}</a>
                      {% if section.settings.ext_btn_link != blank %}
                        <a href="{{ section.settings.ext_btn_link }}" class="button button--primary external-button"><img src="{{ section.settings.img_ext | img_url: '' }}"/></a>
                      {% endif %}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endcapture -%}

      <div {% if is_boxed %}style="width: 100%"{% else %}class="container"{% endif %}>
        {{- section_content -}}
      </div>
    </image-with-text-overlay>
  </div>
  {% if section.settings.animation_smoke != blank %}
    <div class="effect-smoke-box"><img src="{{ section.settings.animation_smoke | img_url: '' }}"/></div>
  {% endif %}

  {% if section.settings.animation_sparx != blank %}
    <div class="effect-sparx-box"><img src="{{ section.settings.animation_sparx | img_url: '' }}"/></div>
  {% endif %}
</section>

<style>
.shopify-section--{{ section.id }} .effect-smoke-box img,
.shopify-section--{{ section.id }} .effect-sparx-box img {
    display: block;
    width: 100%;
}
.shopify-section--{{ section.id }} .effect-smoke-box {
    position: absolute;
    bottom: 0;
    max-width: 75%;
    width: 100%;
}
  .custom-imge-float {
    position: absolute;
    right: 0;
    top: 80px;
    width: 300px;
    transform: translate(0%, 0%);
}
.shopify-section--{{ section.id }} .effect-sparx-box {
    position: absolute;
    right: 0;
    bottom: 0;
}
.shopify-section--{{ section.id }} .effect-sparx-box {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 50%;
    width: 100%;
}
@media only screen and (max-width: 740px) {
  .shopify-section--{{ section.id }} .effect-smoke-box img {
    height: 100%;
  }
.custom-imge-float {
    position: absolute;
    left: 50%;
    top: 0;
    width: 150px;
    transform: translate(-50%, -116%);
    z-index: 2;
}
  .shopify-section--{{ section.id }} .effect-smoke-box {
    max-width: 100%;
    height: 40%;;
  }
  .shopify-section--{{ section.id }} .effect-sparx-box {
    width: 100%;
    max-width: 100%;
    height: 100%;
  }
  .shopify-section--{{ section.id }} .effect-sparx-box img {
    height: 100%;
    object-fit: contain;
  }
}
</style>
{% schema %}
