{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}
<style>
.shopify-section--{{ section.id }} .get-slide--tabs .fill-color {
  color: {{ section.settings.text_color }};
}
.shopify-section--{{ section.id }} .content_button_area .button {
  color: {{ section.settings.button_color }};
  background: {{ section.settings.button_background_color }};
}
{% if section.settings.out_spacing %}
section.banner-tabs-section.shopify-section--{{ section.id }} {
  margin: 0 !important;
}
{% endif %}

section.banner-tabs-section.shopify-section--{{ section.id }} .header-wrapper-part .heading {
  text-align: {% if section.settings.heading_alignment == 'left' %}left
              {% elsif section.settings.heading_alignment == 'center' %}center
              {% elsif section.settings.heading_alignment == 'right' %}right{% endif %}
}

@media only screen and (max-width: 740px) {
  section.banner-tabs-section.shopify-section--{{ section.id }} {
    padding-top: 70px !important;
    padding-bottom: 50px !important;
  }
}
</style>

<section class="section{% unless is_boxed %} section--flush{% endunless %} banner-tabs-section shopify-section--{{ section.id }}"
          style="background: {{ section.settings.bg_color_all }};
                 padding-top: {{ section.settings.padding_top }}px;
                 padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div {% if is_boxed %}class="container"{% endif %}>
    <div class="get-started-watching-videos">
      {% if section.settings.heading != blank %}
      <div class="header-wrapper-part">
        <h2 class="heading h2" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      </div>
      {% endif %}

      <div class="get-section-tabs">
        {% for block in section.blocks %}
        <div class="get-slide--tabs">
          <div class="get-box-inner">
            {% if block.settings.kicker != blank %}
            <div class="badge-kicker">
              <img src="https://cdn.shopify.com/s/files/1/0337/8629/files/Subtract.svg?v=1682328280"/>
              <p class="fill-color">{{ block.settings.kicker }}</p>
            </div>
            {% endif %}

            {% if block.settings.heading != blank %}
            <div class="box-heading">
              <h3 class="heading h2 fill-color">{{ block.settings.heading }}</h3>
            </div>
            {% endif %}

            {% if block.settings.content_area != blank %}
            <div class="content-area">
              <div class="fill-color">{{ block.settings.content_area }}</div>
            </div>
            {% endif %}

            {% if block.settings.button_label != blank %}
            <div class="content_button_area">
              <a class="button" href="{{ block.settings.button_link }}" target="blank">{{ block.settings.button_label }}</a>
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Banner Tabs",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading Alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "background_type",
        "label": "Background",
        "options": [
          {
            "value": "full_width",
            "label": "Full width"
          },
          {
            "value": "boxed",
            "label": "Boxed"
          }
        ],
        "default": "full_width"
      },
      {
        "type": "checkbox",
        "id": "out_spacing",
        "label": "Hide outer Spacing",
        "default": false
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "unit": "px",
        "step": 2,
        "default": 20
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 100,
        "unit": "px",
        "step": 2,
        "default": 20
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "bg_color_all",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Content Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "button_color",
        "label": "Button Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "button_background_color",
        "label": "Button Background Color",
        "default": "#000000"
      }
    ],
    "blocks": [
      {
        "type": "block",
        "name": "Tab",
        "settings": [
          {
            "type": "text",
            "id": "kicker",
            "label": "Kicker"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "content_area",
            "label": "Content"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Button Label"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Banner Tabs"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}