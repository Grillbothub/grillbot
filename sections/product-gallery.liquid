    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px;
  }

  /* ─────────────────────────────────────────
     Grid media cards
  ───────────────────────────────────────── */
  .pg__right--grid {
    flex-direction: column;
    gap: 16px;
  }

  .pg__grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .pg__grid-card {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 2.15 / 1;
    background-color: #1a1a1a;
  }

  .pg__grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pg__grid-placeholder {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
  }

  .pg__grid-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.4);
  }

  .pg__grid-heading {
    position: absolute;
    top: 34px;
    right: 34px;
    margin: 0;
    color: #fff;
    font-family: Anton, sans-serif !important;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
    text-align: right;
    max-width: 428px;
    pointer-events: none;
  }

  .pg__grid-play {
    position: absolute;
    bottom: 34px;
    right: 34px;
    border-radius: 50%;
    border: none;
    color: #B6D22F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding-left: 3px;
    transition: opacity 0.2s ease;
  }

  .pg__grid-play:hover {
    opacity: 0.8;
  }

  /* ─────────────────────────────────────────
     Video Modal
  ───────────────────────────────────────── */
  .pg__modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .pg__modal.is-open {
    display: flex;
  }

  .pg__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.88);
  }

  .pg__modal-box {
    position: relative;
    z-index: 1;
    width: 90vw;
    max-width: 900px;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
  }

  .pg__modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
