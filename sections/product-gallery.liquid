    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 300;
    line-height: 24px;
    margin:0px;
  }

  /* CTA */
 a.pg__btn {
    display: flex;
    width: 238px;
    height: 56px;
    padding: 16px 32px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 100px;
    background: #B6D22F;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 22px;
    margin-top:60px
}

  .pg__btn:hover { opacity: 0.85; }

  /* ─────────────────────────────────────────
     RIGHT
  ───────────────────────────────────────── */
  .pg__right {
    display: flex;
    flex-direction: row;
    gap: 12px;
    align-items: flex-start;
    max-width: 55.8%;
    width: 100%;
}

  /* Main viewer */


  .pg__main-viewer {
    flex: 1;
    border-radius: 14px;
    overflow: hidden;
    background-color: #1a1a1a;
    aspect-ratio: 1/1.12;
    position: relative;
}

  .pg__main-item {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .pg__main-item--active {
    display: block;
  }

  .pg__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Play button overlay */
  .pg__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
  
    border: none;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
    z-index: 2;
