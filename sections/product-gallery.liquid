    padding: 16px 0;
    border-bottom: 1px solid #22260E;
  }

  .pg__feature:first-child {
    border-top: 1px solid #22260E;
  }

  .pg__feature-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #AAFF00;
    margin-top: 2px;
  }

  .pg__feature-icon img {
    width: 44px;
