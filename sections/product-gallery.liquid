        background: #B6D22F;
  }

  .pg__play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: #AAFF00;
  }

  /* ─────────────────────────────────────────
     Thumbnail Swiper (vertical)
  ───────────────────────────────────────── */
  .pg__thumbs-wrap {
    width: 120px;
    flex-shrink: 0;
  }

  .pg__thumbs-swiper {
    height: 100%;
  }

  .pg__thumbs-swiper .swiper-wrapper {
    flex-direction: column;
  }

  .pg__thumb-slide {
    width: 120px !important;
    height: 120px !important;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s ease;
    position: relative;
    background-color: #1a1a1a;
    flex-shrink: 0;
    margin-bottom: 10px;
   
  }

  .pg__thumb-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pg__thumb-slide--active {
    border-color: #AAFF00;
   
  }

  .pg__thumb-placeholder {
