</style>

<!-- Swiper JS -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const sectionId = '{{ section.id }}';
  const layout    = '{{ section.settings.media_layout | default: "slider" }}';
  const viewer    = document.getElementById('pg-viewer-' + sectionId);
  const modal     = document.getElementById('pg-modal-' + sectionId);
  const modalMedia = modal ? modal.querySelector('.pg__modal-media') : null;
  const thumbsEl  = document.getElementById('pg-thumbs-' + sectionId);
  const gridEl    = document.getElementById('pg-grid-' + sectionId);

  /* ── Helpers ── */
  function isYouTube(url) { return url && (url.includes('youtube.com') || url.includes('youtu.be')); }
  function isVimeo(url)   { return url && url.includes('vimeo.com'); }

  function getYouTubeId(url) {
    const m = url.match(/(?:v=|youtu\.be\/)([^&?/]+)/);
    return m ? m[1] : null;
  }

  function getVimeoId(url) {
    const m = url.match(/vimeo\.com\/(\d+)/);
    return m ? m[1] : null;
  }

  function buildEmbedHTML(videoUrl) {
    if (isYouTube(videoUrl)) {
      const id = getYouTubeId(videoUrl);
      return '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0" allow="autoplay; fullscreen" allowfullscreen></iframe>';
    }
    if (isVimeo(videoUrl)) {
      const id = getVimeoId(videoUrl);
      return '<iframe src="https://player.vimeo.com/video/' + id + '?autoplay=1" allow="autoplay; fullscreen" allowfullscreen></iframe>';
    }
    /* Direct video file */
    return '<video src="' + videoUrl + '" autoplay controls playsinline></video>';
  }

  /* ── Open / close modal ── */
  function openModal(videoUrl) {
    if (!modal || !modalMedia) return;
    modalMedia.innerHTML = buildEmbedHTML(videoUrl);
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalMedia) return;
    modalMedia.innerHTML = '';
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  if (modal) {
    modal.querySelector('.pg__modal-backdrop').addEventListener('click', closeModal);
    modal.querySelector('.pg__modal-close').addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  }

  /* ── Grid layout: play buttons ── */
  if (layout === 'grid' && gridEl) {
    gridEl.querySelectorAll('.pg__grid-play').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('.pg__grid-card');
        if (card && card.dataset.video) openModal(card.dataset.video);
      });
    });
    return;
  }

  /* ── Slider layout ── */
  if (!thumbsEl) return;

  const isMobile = () => window.innerWidth <= 900;

  const thumbSwiper = new Swiper('#pg-thumbs-' + sectionId, {
    direction: isMobile() ? 'horizontal' : 'vertical',
    slidesPerView: 'auto',
    spaceBetween: 10,
    freeMode: true,
    watchSlidesProgress: true,
  });

  window.addEventListener('resize', function () {
    if (thumbSwiper) {
      thumbSwiper.changeDirection(isMobile() ? 'horizontal' : 'vertical', true);
    }
  });

  function activateSlide(thumb) {
    if (!viewer) return;

    const type     = thumb.dataset.type;
    const src      = thumb.dataset.src;
    const alt      = thumb.dataset.alt || '';
    const videoUrl = thumb.dataset.video;

    viewer.innerHTML = '';

    const item = document.createElement('div');
    item.className = 'pg__main-item pg__main-item--active';
    item.dataset.type = type;
    if (videoUrl) item.dataset.video = videoUrl;

    const img = document.createElement('img');
    img.className = 'pg__main-img';
    img.src = src;
    img.alt = alt;
    item.appendChild(img);

    if (type === 'video' && videoUrl) {
      const btn = document.createElement('button');
      btn.className = 'pg__play-btn';
      btn.setAttribute('aria-label', 'Play video');
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
      btn.addEventListener('click', function () { openModal(videoUrl); });
      item.appendChild(btn);
    }

    viewer.appendChild(item);

    document.querySelectorAll('#pg-thumbs-' + sectionId + ' .pg__thumb-slide').forEach(function (t) {
      t.classList.remove('pg__thumb-slide--active');
    });
    thumb.classList.add('pg__thumb-slide--active');
  }

  thumbsEl.querySelectorAll('.pg__thumb-slide').forEach(function (thumb) {
    thumb.addEventListener('click', function () { activateSlide(thumb); });
  });

  if (viewer) {
    viewer.addEventListener('click', function (e) {
      const btn = e.target.closest('.pg__play-btn');
      if (btn) {
        const item = btn.closest('.pg__main-item');
        if (item && item.dataset.video) openModal(item.dataset.video);
      }
    });
  }
});
</script>

