<section>
  {%- if blog.articles_count == 0 -%}
    <div class="empty-state text-container">
      <h1 class="heading h1">{{ blog.title }}</h1>

      <p class="text--large">{{ 'blog.general.empty' | t }}</p>

      <div class="button-wrapper">
        <a href="{{ routes.root_url }}" class="button button--primary">{{ 'blog.general.back_to_home' | t }}</a>
      </div>
    </div>
  {%- else -%}
    {%- if section.settings.show_blog_title -%}
      <div class="page-header custom-page--header">
        {% if section.settings.show_breadcrumb %}
        <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb breadcrumb--floating text--xsmall hidden-phone">
          <ol class="breadcrumb__list" role="list">
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
            </li>

            <li class="breadcrumb__item">
              {%- if current_tags -%}
                <a class="breadcrumb__link" href="{{ collection.url }}">{{ blog.title }}</a>
              {%- else -%}
                <span class="breadcrumb__link" aria-current="page">{{ blog.title }}</span>
              {%- endif -%}
            </li>

            {%- if current_tags -%}
              <li class="breadcrumb__item">
                <span class="breadcrumb__link" aria-current="page">{{ current_tags.first | split: '_' | last }}</span>
              </li>
            {%- endif -%}
          </ol>
        </nav>
        {% endif %}

        {% if section.settings.image_banner != blank or section.settings.mobile_banner != blank %}
        <div class="blog_banner-wrapper">
          <div class="blog--image">
            <img class="desktop-img" src="{{ section.settings.image_banner | img_url: '' }}"/>
            <img class="mobile-img" src="{{ section.settings.mobile_banner | img_url: '' }}"/>
          </div>
        </div>
        {% endif %}
    
        <div class="page-header__text-wrapper text-container main-heading--blog_wrapper">
          <h1 class="heading h1">{{ blog.title }}</h1>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>
{% schema %}
  {
    "name": "Blog Banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_blog_title",
        "label": "Show blog title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumb",
        "label": "Show Breadcrumbs",
        "default": true
      },
      {
        "type":"image_picker",
        "id": "image_banner",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "mobile_banner",
        "label": "Mobile Image"
      }
    ],
    "presets": [
      {
        "name": "Blog Banner"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}