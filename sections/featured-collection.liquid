{% comment %} Featured Collection Swiper Section {% endcomment %}


{%- assign section_pt_desktop = section.settings.padding_top_desktop | append: 'px' -%}
{%- assign section_pb_desktop = section.settings.padding_bottom_desktop | append: 'px' -%}
{%- assign section_pt_mobile = section.settings.padding_top_mobile | append: 'px' -%}
{%- assign section_pb_mobile = section.settings.padding_bottom_mobile | append: 'px' -%}

<style>
  #shopfavs-{{ section.id }} {
    background: #000000;
    padding-top: {{ section_pt_desktop }};
    padding-bottom: {{ section_pb_desktop }};
    overflow:hidden;
  }

  #shopfavs-{{ section.id }} .sf-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #shopfavs-{{ section.id }} .sf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  #shopfavs-{{ section.id }} .sf-heading {

    margin: 0;
    line-height: 1;
    color: #FFF;
    font-family: Anton!important;
    font-size: 52px;
    font-style: normal;
    font-weight: 400;
    line-height: 60px;
    letter-spacing: -0.8px;
    text-transform: uppercase;
}
  

  #shopfavs-{{ section.id }} .sf-nav {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  #shopfavs-{{ section.id }} .sf-btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid #B6D22F;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
  }

  #shopfavs-{{ section.id }} .sf-btn:hover {
    background: rgba(255,255,255,0.15);
    border-color: #fff;
  }

  #shopfavs-{{ section.id }} .sf-btn svg {
    width: 24px;
    height: 24px;
  }

  /* Card */
  #shopfavs-{{ section.id }} .sf-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    padding: 20px 20px 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
    padding-top:0px;
  }

  #shopfavs-{{ section.id }} .sf-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  }

  #shopfavs-{{ section.id }} .sf-card-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    margin-bottom: 16px;
    border-radius: 10px;
    overflow: hidden;
    background: #f5f5f5;
  }

  #shopfavs-{{ section.id }} .sf-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopfavs-{{ section.id }} .sf-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    color: #fff;
    letter-spacing: 0.5px;
    z-index: 2;
        border-radius: 100px;
    
    color: #C14126;
    text-align: center;
    font-family: Rubik;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 22px;
  }

  #shopfavs-{{ section.id }} .sf-badge--bestseller { background:  #F8E4E4; }
  #shopfavs-{{ section.id }} .sf-badge--sale { background: #cc2200; }

  #shopfavs-{{ section.id }} .sf-card-title {
    text-transform: uppercase;
    letter-spacing: 0.2px;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 22px;
    font-style: normal;
    font-weight: 700;
    line-height: 34px;
    margin:0px;
  }

  #shopfavs-{{ section.id }} .sf-card-desc {
  
    text-align: center;
    font-family: Rubik;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 22px;
    text-transform: capitalize;
    margin:0px;
    margin-bottom:12px;

  }

  #shopfavs-{{ section.id }} .sf-pricing {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: auto;
    justify-content:center;
  }

  #shopfavs-{{ section.id }} .sf-compare-price {
    font-size: 0.85rem;
    color: #aaa;
    text-decoration: line-through;
  }

  #shopfavs-{{ section.id }} .sf-discount-badge {
  
    border-radius: 4px;
    background: #A10505;
    display: flex;
    /* height: 24px; */
    padding: 0 6px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: var(--white, #FFF);
text-align: center;
font-family: Rubik;
font-size: 16px;
font-style: normal;
font-weight: 500;
line-height: 22px; /* 137.5% */
}
  

  #shopfavs-{{ section.id }} .sf-price {
   
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 22px;
    background: transparent;
    padding: 0px;
}

  /* Swiper overrides */
  #shopfavs-{{ section.id }} .swiper {
    overflow: visible;
    padding-bottom: 4px;
  }

  #shopfavs-{{ section.id }} .swiper-slide {
    height: auto;
  }

  @media (max-width: 767px) {
    #shopfavs-{{ section.id }} {
      padding-top: {{ section_pt_mobile }};
      padding-bottom: {{ section_pb_mobile }};
    }
        #shopfavs-{{ section.id }} .sf-card-title {
        color: var(--Black, #080808);
text-align: center;
font-family: Rubik;
font-size: 18px;
font-style: normal;
font-weight: 700;
line-height: 30px; /* 166.667% */
      }
        #shopfavs-{{ section.id }}   h2.sf-heading {
    color: #FFF;
    font-family: Anton;
    font-size: 38px;
    font-style: normal;
    font-weight: 400;
    line-height: 44px;
    letter-spacing: -0.8px;
    text-transform: uppercase;
}
#shopfavs-{{ section.id }} .sf-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #B6D22F;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
}
#shopfavs-template--18528789135423__featured_collection_hagxzd .sf-card-title {
    text-transform: uppercase;
    letter-spacing: 0.2px;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 22px;
    font-style: normal;
    font-weight: 700;
    line-height: 34px;
    margin: 0px;
    color: var(--Black, #080808);
    text-align: center;
    font-family: Rubik;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 30px;
}
  }
</style>

<section id="shopfavs-{{ section.id }}">
  <div class="sf-inner">

    <div class="sf-header">
      <h2 class="sf-heading">{{ section.settings.heading }}</h2>
      <div class="sf-nav">
        <button class="sf-btn sf-prev-{{ section.id }}" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
  <path d="M20 13L20 11L8 11L8 9L6 9L6 11L4 11L4 13L6 13L6 15L8 15L8 13L20 13ZM10 17L8 17L8 15L10 15L10 17ZM10 17L12 17L12 19L10 19L10 17ZM10 7L8 7L8 9L10 9L10 7ZM10 7L12 7L12 5L10 5L10 7Z" fill="#B6D22F"/>
</svg>
        </button>
        <button class="sf-btn sf-next-{{ section.id }}" aria-label="Next">
         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
  <path d="M4 11L4 13L16 13L16 15L18 15L18 13L20 13L20 11L18 11L18 9L16 9L16 11L4 11ZM14 7L16 7L16 9L14 9L14 7ZM14 7L12 7L12 5L14 5L14 7ZM14 17L16 17L16 15L14 15L14 17ZM14 17L12 17L12 19L14 19L14 17Z" fill="#B6D22F"/>
</svg>
        </button>
      </div>
    </div>

    <div class="swiper sf-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- assign collection = collections[section.settings.collection] -%}
        {%- assign product_limit = section.settings.products_to_show -%}

        {%- if collection != blank -%}
          {%- for product in collection.products limit: product_limit -%}
            {%- assign is_sale = false -%}
            {%- assign is_bestseller = false -%}
            {%- for tag in product.tags -%}
              {%- assign tag_lower = tag | downcase -%}
              {%- if tag_lower == 'sale' %}{%- assign is_sale = true -%}{%- endif -%}
              {%- if tag_lower == 'bestseller' or tag_lower == 'best seller' %}{%- assign is_bestseller = true -%}{%- endif -%}
            {%- endfor -%}

            {%- assign has_compare = false -%}
            {%- assign discount_pct = 0 -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign has_compare = true -%}
              {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            {%- endif -%}

            <div class="swiper-slide">
              <a href="{{ product.url }}" class="sf-card">
                <div class="sf-card-img-wrap">
                  {%- if is_bestseller -%}
                    <span class="sf-badge sf-badge--bestseller">Bestseller</span>
                  {%- elsif is_sale -%}
                    <span class="sf-badge sf-badge--sale">Sale</span>
                  {%- endif -%}
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>

                <h3 class="sf-card-title">{{ product.title }}</h3>

                {%- assign fbt_line_raw = product.metafields.custom.card_subtitle.value
                      | default: product.metafields.custom.card_subtitle
                      | default: product.metafields.custom.short_description.value
                      | default: product.metafields.custom.short_description
                    -%}
                    {%- if fbt_line_raw == blank -%}
                      {%- assign fbt_line_raw = product.description -%}
                    {%- endif -%}
                    {%- assign fbt_line = fbt_line_raw | strip_html | strip_newlines | strip -%}
                    {% if fbt_line != blank %}
                  <p class="sf-card-desc">{{ fbt_line | truncate: 60 }}</p>
                {%- endif -%}

                <div class="sf-pricing">
                  {%- if has_compare -%}
                    <span class="sf-compare-price">{{ product.compare_at_price | money }}</span>
                    <span class="sf-discount-badge">-{{ discount_pct }}%</span>
                  {%- endif -%}
                  <span class="sf-price">{{ product.price | money }}</span>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="swiper-slide">
              <a href="#" class="sf-card">
                <div class="sf-card-img-wrap">
                  <span class="sf-badge sf-badge--bestseller">Bestseller</span>
                  {{ 'product-' | append: i | placeholder_svg_tag }}
                </div>
                <h3 class="sf-card-title">Sample Product {{ i }}</h3>
                <p class="sf-card-desc">Select a collection in the customizer to show real products.</p>
                <div class="sf-pricing">
                  <span class="sf-compare-price">Rs 1,999.00</span>
                  <span class="sf-discount-badge">-20%</span>
                  <span class="sf-price">Rs 1,199.00</span>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    function initSwiper() {
      new Swiper('.sf-swiper-{{ section.id }}', {
        slidesPerView: 1.2,
        spaceBetween: 9,
        grabCursor: true,
        navigation: {
          prevEl: '.sf-prev-{{ section.id }}',
          nextEl: '.sf-next-{{ section.id }}',
        },
        breakpoints: {
          560: { slidesPerView: 2, spaceBetween: 9 },
          900: { slidesPerView: 3, spaceBetween: 9 },
          1200: { slidesPerView: 3, spaceBetween: 9 },
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwiper);
    } else {
      initSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Collection v2",
  "tag": "div",
  "class": "featured-collection-swiper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Favorites"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top (px)",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (px)",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (px)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Collection v2"
    }
  ]
}
{% endschema %}
