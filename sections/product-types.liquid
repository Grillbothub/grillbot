            "label": "Point 2"
          },
          {
            "type": "url",
            "id": "key_link_2",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "svg_text_3",
            "label": "Point 3"
          },
          {
            "type": "url",
            "id": "key_link_3",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "svg_text_4",
            "label": "Point 4"
          },
          {
            "type": "url",
            "id": "key_link_4",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "svg_text_5",
            "label": "Point 5"
          },
          {
            "type": "url",
