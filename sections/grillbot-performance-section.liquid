{%- comment -%}
Grillbot - Performance (metaobject driven)

Expected metafields (pick the one your admin created):
1) product.metafields.custom.grillbot_performance_section.value
2) product.metafields.custom.grillbot_performance.value

Metaobject fields (as per your plan):
- heading
- content
- icon, text
- icon_2, text_2
- icon_3, text_3
- icon_4, text_4
- icon_5, text_5
- icon_6, text_6
{%- endcomment -%}

{%- assign perf_mo = product.metafields.custom.grillbot_performance_section.value | default: product.metafields.custom.grillbot_performance.value -%}

{%- if request.page_type == 'product' and product != blank and perf_mo != blank -%}
  {%- assign perf_heading = perf_mo.heading.value | default: perf_mo.heading -%}
  {%- assign perf_content = perf_mo.content.value | default: perf_mo.content -%}

  {%- assign perf_main_image = perf_mo.main_image.value | default: perf_mo.main_image -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.mainImage.value | default: perf_mo.mainImage -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.mainimage.value | default: perf_mo.mainimage -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.main_image_1.value | default: perf_mo.main_image_1 -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.center_image.value | default: perf_mo.center_image -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.centerImage.value | default: perf_mo.centerImage -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = perf_mo.image.value | default: perf_mo.image -%}
  {%- endif -%}
  {%- if perf_main_image == blank -%}
    {%- assign perf_main_image = section.settings.main_image -%}
  {%- endif -%}

  {%- assign perf_mobile_image = perf_mo.mobile_image.value | default: perf_mo.mobile_image -%}
  {%- if perf_mobile_image == blank -%}
    {%- assign perf_mobile_image = perf_mo.mobileImage.value | default: perf_mo.mobileImage -%}
  {%- endif -%}
  {%- if perf_mobile_image == blank -%}
    {%- assign perf_mobile_image = perf_mo.mobileimage.value | default: perf_mo.mobileimage -%}
  {%- endif -%}
  {%- if perf_mobile_image == blank -%}
    {%- assign perf_mobile_image = perf_mo.mobile_image_1.value | default: perf_mo.mobile_image_1 -%}
  {%- endif -%}
  {%- if perf_mobile_image == blank -%}
    {%- assign perf_mobile_image = perf_main_image -%}
  {%- endif -%}

  {%- assign perf_main_image_render = perf_main_image -%}
  {%- if perf_main_image != blank and perf_main_image.preview_image != blank -%}
    {%- assign perf_main_image_render = perf_main_image.preview_image -%}
  {%- endif -%}

  {%- assign perf_mobile_image_render = perf_mobile_image -%}
  {%- if perf_mobile_image != blank and perf_mobile_image.preview_image != blank -%}
    {%- assign perf_mobile_image_render = perf_mobile_image.preview_image -%}
  {%- endif -%}

  {%- assign perf_icon_1 = perf_mo.icon.value | default: perf_mo.icon -%}
  {%- assign perf_text_1 = perf_mo.text.value | default: perf_mo.text -%}

  {%- assign perf_icon_2 = perf_mo.icon_2.value | default: perf_mo.icon_2 -%}
  {%- assign perf_text_2 = perf_mo.text_2.value | default: perf_mo.text_2 -%}

  {%- assign perf_icon_3 = perf_mo.icon_3.value | default: perf_mo.icon_3 -%}
  {%- assign perf_text_3 = perf_mo.text_3.value | default: perf_mo.text_3 -%}

  {%- assign perf_icon_4 = perf_mo.icon_4.value | default: perf_mo.icon_4 -%}
  {%- assign perf_text_4 = perf_mo.text_4.value | default: perf_mo.text_4 -%}

  {%- assign perf_icon_5 = perf_mo.icon_5.value | default: perf_mo.icon_5 -%}
  {%- assign perf_text_5 = perf_mo.text_5.value | default: perf_mo.text_5 -%}

  {%- assign perf_icon_6 = perf_mo.icon_6.value | default: perf_mo.icon_6 -%}
  {%- assign perf_text_6 = perf_mo.text_6.value | default: perf_mo.text_6 -%}

  {%- assign has_any_item = false -%}
  {%- if perf_icon_1 != blank or perf_text_1 != blank or perf_icon_2 != blank or perf_text_2 != blank or perf_icon_3 != blank or perf_text_3 != blank or perf_icon_4 != blank or perf_text_4 != blank or perf_icon_5 != blank or perf_text_5 != blank or perf_icon_6 != blank or perf_text_6 != blank -%}
    {%- assign has_any_item = true -%}
  {%- endif -%}

  {%- if perf_heading != blank or perf_content != blank or has_any_item -%}
    {% style %}
      #shopify-section-{{ section.id }} .hb-grillbot-performance {
        background: {{ section.settings.background }};
        padding-top: {{ section.settings.padding-desktop-top }}px;
        padding-bottom: {{ section.settings.padding-desktop-bottom }}px;
        color: {{ section.settings.text_color }};
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__head {
        text-align: center;
        margin: 0 0 32px;
        padding-left: 32px;
        padding-right: 32px;
        max-width: 1440px;
        margin-left: auto;
        margin-right: auto;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__title {
        margin: 0 0 16px;
        font-family: Anton !important;
        font-size: 52px;
        line-height: 60px;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: -0.8px;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__sub {
        margin: 0 auto;
        font-size: 20px;
        line-height: 28px;
        font-weight: 400;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__stage {
        position: relative;
        max-width: 1440px;
        margin: 0 auto;
      }

      /* Main image: 1440×508 frame, centered, no stretch */
      #shopify-section-{{ section.id }} .hb-grillbot-performance__image {
        position: relative;
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        aspect-ratio: 1440 / 508;
        height: 508px;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 508px;
        object-fit: cover;
        object-position: center center;
        display: block;
      }

      /* Overlay wrapper (absolute) on top of the image */
      #shopify-section-{{ section.id }} .hb-grillbot-performance__overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 120px;
        pointer-events: none;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__overlay > * {
        pointer-events: auto;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__overlay-gap {
        flex: 1 1 auto;
        height: 1px;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__mobile-image {
        display: none;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__list {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__icon img {
        object-fit: contain;
        display: block;
      }

      #shopify-section-{{ section.id }} .hb-grillbot-performance__text {
        font-size: 20px;
        line-height: 28px;
        font-weight: 600;
        max-width: 285px;
      }
