    {% endstyle %}

    <section class="hb-grillbot-performance shopify-section--{{ section.id }}" aria-label="Grillbot Performance">
      {%- if perf_heading != blank or perf_content != blank -%}
        <div class="hb-grillbot-performance__head">
          {%- if perf_heading != blank -%}
            <h2 class="hb-grillbot-performance__title">{{ perf_heading | escape }}</h2>
          {%- endif -%}
          {%- if perf_content != blank -%}
            <p class="hb-grillbot-performance__sub">{{ perf_content | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hb-grillbot-performance__stage">
        <div class="hb-grillbot-performance__image" aria-hidden="true">
          {%- if perf_main_image_render != blank -%}
            {{ perf_main_image_render | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '900,1000,1200,1440,1600,2000', sizes: '(min-width: 1440px) 1440px, (min-width: 1000px) 100vw, 100vw', alt: 'Product Image' }}
          {%- endif -%}
        </div>

        <div class="hb-grillbot-performance__overlay">
          <div class="hb-grillbot-performance__list hb-grillbot-performance__list--left" aria-label="Performance features (1-3)">
            {%- if perf_icon_1 != blank or perf_text_1 != blank -%}
              <div class="hb-grillbot-performance__item">
                {%- if perf_icon_1 != blank -%}
                  <span class="hb-grillbot-performance__icon" aria-hidden="true">
                    {{ perf_icon_1 | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '22px', alt: '' }}
                  </span>
                {%- endif -%}
                {%- if perf_text_1 != blank -%}
                  <div class="hb-grillbot-performance__text">{{ perf_text_1 | escape | newline_to_br }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if perf_icon_2 != blank or perf_text_2 != blank -%}
              <div class="hb-grillbot-performance__item">
                {%- if perf_icon_2 != blank -%}
                  <span class="hb-grillbot-performance__icon" aria-hidden="true">
