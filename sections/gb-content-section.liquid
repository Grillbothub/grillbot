{%- comment -%}
  GB - Content
  Optional product metafield (namespace: custom):
  - grillbot_content_section (Metaobject - single)
    - subheading (Single line text)
    - heading (Single line text)
    - content (Rich text)
{%- endcomment -%}

{%- assign gb_content_mo = blank -%}
{%- if request.page_type == 'product' and product != blank -%}
  {%- assign gb_content_mo = product.metafields.custom.grillbot_content_section.value
    | default: product.metafields.custom.grillbot_content_section
  -%}
{%- endif -%}

{%- if gb_content_mo != blank -%}
  {%- assign gb_subheading = gb_content_mo.subheading.value | default: gb_content_mo.subheading -%}
  {%- assign gb_heading = gb_content_mo.heading.value | default: gb_content_mo.heading -%}
  {%- assign gb_text = gb_content_mo.content | default: gb_content_mo.description -%}
{%- else -%}
  {%- assign gb_subheading = section.settings.subheading -%}
  {%- assign gb_heading = section.settings.heading -%}
  {%- assign gb_text = section.settings.text -%}
{%- endif -%}

{%- if gb_subheading != blank or gb_heading != blank or gb_text != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} .gb-content {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_desktop_top }}px;
      padding-bottom: {{ section.settings.padding_desktop_bottom }}px;
    }

    #shopify-section-{{ section.id }} .gb-content__head {
      text-align: {{ section.settings.text_alignment }};
      max-width: {{ section.settings.content_max_width }}px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .gb-content__subheading {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 3px 14px;
      border-radius: 4px;
      background: {{ section.settings.subheading_bg }};
      color: {{ section.settings.subheading_text_color }};
      font-size: 16px;
      line-height: 22px;
      font-weight: 400;
      margin: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .gb-content__heading {
      margin: 0;
      font-family: Anton, sans-serif !important;
      font-size: 52px;
      font-weight: 400;
      line-height: 60px;
      text-transform: uppercase;
      color: {{ section.settings.heading_color }};
    }

    #shopify-section-{{ section.id }} .gb-content__text {
      margin: 10px 0 0;
      font-size: 20px;
      line-height: 28px;
      font-weight: 400;
      color: {{ section.settings.text_color }};
    }

    #shopify-section-{{ section.id }} .gb-content__text p {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .gb-content__text p + p {
      margin-top: 12px;
    }

    @media screen and (max-width: 991px) {
      #shopify-section-{{ section.id }} .gb-content {
        padding-top: {{ section.settings.padding_mobile_top }}px;
        padding-bottom: {{ section.settings.padding_mobile_bottom }}px;
      }

      #shopify-section-{{ section.id }} .gb-content__heading {
        font-size: 36px;
        line-height: 44px;
      }

      #shopify-section-{{ section.id }} .gb-content__text {
        font-size: 16px;
        line-height: 26px;
      }
    }
  {% endstyle %}

  <section class="gb-content" aria-label="{{ gb_heading | default: 'Content' | escape }}">
    <div class="container">
      <div class="gb-content__head">
        {%- if gb_subheading != blank -%}
          <div class="gb-content__subheading">{{ gb_subheading | escape }}</div>
        {%- endif -%}

        {%- if gb_heading != blank -%}
          <h2 class="gb-content__heading">{{ gb_heading | escape }}</h2>
        {%- endif -%}

        {%- if gb_text != blank -%}
          <div class="gb-content__text rte">
            {%- if gb_content_mo != blank and gb_text.value != blank -%}
              {{ gb_text | metafield_tag }}
            {%- else -%}
              {{ gb_text }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "GB - Content",
  "class": "shopify-section--gb-content",
  "disabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Grillbot Works"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Unlike a traditional BBQ grill brush, Grillbot automatically cleans grill grates while you focus on cooking, entertaining, or preparing your next meal.</p>"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 710
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "subheading_bg", "label": "Subheading background", "default": "#B6D22F" },
    { "type": "color", "id": "subheading_text_color", "label": "Subheading text", "default": "#080808" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_desktop_top", "label": "Padding top (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_desktop_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_mobile_top", "label": "Padding top (mobile)", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_mobile_bottom", "label": "Padding bottom (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "GB - Content", "category": "Custom" }
  ]
}
{% endschema %}
