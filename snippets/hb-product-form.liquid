<script>
  (function () {
    var productFormId = {{ product_form_id | json }};

    function formatHbSavings(cents) {
      return formatMoney(cents).replace(/\s/g, '').replace(/\.00$/, '').replace(/,00$/, '');
    }

    var hasSaleTag = {{ is_sale | json }};

    function syncHbProductPrices(variant) {
      if (!variant) return;

      var currencyFormat = window.themeVariables.settings.currencyCodeEnabled
        ? window.themeVariables.settings.moneyWithCurrencyFormat
        : window.themeVariables.settings.moneyFormat;

      document.querySelectorAll('.product-form [data-product-price-list]').forEach(function (priceList) {
        priceList.innerHTML = '';

        if (variant.compare_at_price > variant.price) {
          priceList.innerHTML += '<span class="price price--highlight price--large"><span class="visually-hidden">' + window.themeVariables.strings.productSalePrice + '</span>' + formatMoney(variant.price, currencyFormat).replace(/\s/g, '') + '</span>';
          priceList.innerHTML += '<span class="price price--compare"><span class="visually-hidden">' + window.themeVariables.strings.productRegularPrice + '</span>' + formatMoney(variant.compare_at_price, currencyFormat).replace(/\s/g, '') + '</span>';
        } else {
          priceList.innerHTML += '<span class="price price--large"><span class="visually-hidden">' + window.themeVariables.strings.productSalePrice + '</span>' + formatMoney(variant.price, currencyFormat).replace(/\s/g, '') + '</span>';
        }

        if (variant.unit_price_measurement) {
          var referenceValue = variant.unit_price_measurement.reference_value !== 1
            ? '<span class="unit-price-measurement__reference-value">' + variant.unit_price_measurement.reference_value + '</span>'
            : '';

          priceList.innerHTML += '<div class="price text--subdued"><div class="unit-price-measurement"><span class="unit-price-measurement__price">' + formatMoney(variant.unit_price) + '</span><span class="unit-price-measurement__separator">/</span>' + referenceValue + '<span class="unit-price-measurement__reference-unit">' + variant.unit_price_measurement.reference_unit + '</span></div></div>';
        }

        priceList.style.display = '';
      });

      document.querySelectorAll('.product-form [data-product-label-list]').forEach(function (labelList) {
        labelList.innerHTML = '';

        if (!variant.available) {
          labelList.innerHTML = '<span class="label label--subdued">' + window.themeVariables.strings.collectionSoldOut + '</span>';
        } else if (variant.compare_at_price > variant.price) {
          labelList.innerHTML = '<span class="label label--highlight">Save ' + formatHbSavings(variant.compare_at_price - variant.price) + '</span>';
        }
      });

      document.querySelectorAll('.product-form [data-product-sale-notice]').forEach(function (saleNotice) {
        if (hasSaleTag && variant.available && variant.compare_at_price > variant.price) {
          saleNotice.removeAttribute('hidden');
        } else {
          saleNotice.setAttribute('hidden', '');
        }
      });
    }

    function onVariantChanged(event) {
      try {
        var target = event.target;
        if (target && target.id && target.id !== productFormId && target.getAttribute && target.getAttribute('form') !== productFormId) {
          return;
        }
        syncHbProductPrices(event.detail && event.detail.variant);
      } catch (e) {}
    }

    var form = document.getElementById(productFormId);
    if (form) form.addEventListener('variant:changed', onVariantChanged);
    document.addEventListener('variant:changed', onVariantChanged);
  })();
</script>

