    "custom_faq_Jbae84": {
      "type": "custom-faq",
      "blocks": {
        "question_DDMJC4": {
          "type": "question",
          "settings": {
            "title": "What exactly is a Grillbot and how does it work?",
            "answer": "<p><strong>The Grillbot is your grill-cleaning sidekick.</strong></p><p>Just place it on your grill, press a button, and let it go to work, no scrubbing, no mess.</p><p>Grillbot's motorized brushes clean your grates (hot or cold, up to 250°F), and a built-in alarm sound if your grill gets too hot. </p><p>Effortless, automated, and oddly satisfying to watch.</p>"
          }
        },
        "question_nGi9YH": {
          "type": "question",
          "settings": {
            "title": "Will Grillbot work on my grill (gas, charcoal, infrared, Green Egg,Blackstone, etc.)?",
            "answer": "<p><strong>Yes, Grillbot works on all major grill types, with a lid!</strong></p><p>Whether it’s gas, charcoal, ceramic, infrared, or something in between, Grillbot is designed to handle them all.</p><p>If you can grill on it, Grillbot can clean it.</p>"
          }
        },
        "question_pqcTmC": {
          "type": "question",
          "settings": {
            "title": "Will Grillbot scratch or damage my grill?",
            "answer": "<p>Only if you're using the wrong brush but we've got you covered.</p><p>To protect your grill, choose the brush that matches your grate:</p><ul><li><strong>Brass:</strong> Great for porcelain or stainless steel (gentle and effective)</li><li><strong>Nylon:</strong> All-purpose and safe for all grill types</li><li><strong>Stainless Steel:</strong> Best for cast iron and expanded steel (heavy-duty)</li></ul><p>Using a degreaser before cleaning and avoiding overuse can further reduce wear over time.</p>"
          }
        },
        "question_jQLhLX": {
          "type": "question",
          "settings": {
            "title": "Will this make my dirty grill look brand new?",
            "answer": "<p><strong>Not overnight but with regular use, Grillbot keeps your grill in top shape.</strong></p><p>Grillbot is built for maintenance, not restoration. Over time, it removes grease and buildup, helping your grill cook better and last longer.</p><p><em>The more you use it, the better it gets.</em></p>"
          }
        },
        "question_4XPybY": {
          "type": "question",
          "settings": {
            "title": "How do I know which brush is right for my grill?",
            "answer": "<p>Here’s a quick brush guide:</p><ul><li><strong>Nylon:</strong> Softest and longest-lasting. Safe for all grills.</li><li><strong>Brass:</strong> Best for porcelain/stainless steel. Prevents scratches.</li><li><strong>Stainless Steel:</strong> Deep-cleaning for cast iron or expanded steel. </li></ul><p><em>Not sure? Start with Nylon - it’s the safest bet for most users.</em></p>"
          }
        }
      },
