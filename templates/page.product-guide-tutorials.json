mages\/Rectangle_3.jpg","image_mobile":"shopify:\/\/shop_images\/Rectangle_3_1.jpg","video":"","video_sizing":"cover","subheading":"Six reasons grill  cleaning has  never been easier:","background_type":"full_width","text_width":"medium","text_position":"top_left","text_color":"#ffffff","button_background":"#ffffff","button_text_color":"#000000","overlay_color":"#000000","pointer_color":"#000000","pointer_bg":"#ffffff","overlay_opacity":0,"custom_section_class":"tutorials-page-addition"}},"9265a29d-e6fd-4850-b101-4dc67651db5f":{"type":"product-guide-tutorials","blocks":{"f72daf60-fb85-4a7a-abbc-60d48e79bda9":{"type":"heading","settings":{"heading":"Brushes"}},"02702b0b-4ee5-490f-8ce3-9aecc489140c":{"type":"subheading","settings":{"sub_heading":"REMOVING, CLEANING OR REPLACING THE BRUSHES"}},"986200a6-8f16-4783-9351-29f93ea5e03e":{"type":"content","settings":{"content":"<p><strong>Grillbot brushes are easy to remove! <br\/>The replaceable brushes pop right off for easy cleaning and are dishwasher safe. <br\/>This tutorial will explain how to remove the brushes.<\/strong><\/p>"}},"c684e8ce-db84-4b22-a66b-f244952c465b":{"type":"video","settings":{"video_type":"youtube","video":"","iframe":"https:\/\/www.youtube.com\/embed\/BGFmOJ_7oBo","youtube_height":800}},"a01727f9-80af-4a66-ad0d-80ef91a64505":{"type":"subheading","settings":{"sub_heading":"Brushes for the Grillbot"}},"ff3a0fa3-a588-4f74-ba75-ecdc50a72da3":{"type":"error","settings":{"error":"All Grillbot’s come with 3 Nylon brushes installed. Below are additional options."}},"1faf2058-75ca-443d-b334-dc4651bbec1e":{"type":"content","settings":{"content":"<p><strong>What's The Difference Between TheBrass, Stainless Steel, & Nylon Brushes? <\/strong><\/p>"}},"cb01b762-e150-4085-8b81-3d8a353a8042":{"type":"product_types","settings":{"image_1":"shopify:\/\/shop_images\/Rectangle_87.png","heading_1":"Nylon Brushes","content_1":"<p>Introducing the new Nylon brushes. The Nylon brush is softer than the Brass and Stainless Steel brushes, but last longer (may require longer clean cycles). The Nylon brushes won’t scratch the surface, helping keep your grill looking great and works on all types of grill grates.<\/p>","sale_badge_1":"","label_1":"Order Nylon Brushes","link_1":"shopify:\/\/products\/nylon-brush","image_2":"shopify:\/\/shop_images\/Rectangle_87_1.png","heading_2":"Brass Brushes","content_2":"<p>Brass brushes are important if you have a stainless steel or porcelain grill. Brass is a softer metal and won't scratch the surface, helping keep your grill looking great.<\/p>","sale_badge_2":"","label_2":"Order Brass Brushes","link_2":"shopify:\/\/products\/brass-brush","image_3":"shopify:\/\/shop_images\/Rectangle_87_2.png","heading_3":"Stainless Steel Brushes","content_3":"<p>Stainless steel brushes are great for cast iron or expanded steel grills. Cast iron is by far the best outdoor cooking surface because it holds heat better than other kinds of grills. However, these kinds of grills are higher maintenance. The bristles of steel brushes are able to better penetrate the tiny pores in the cast iron. This allows for a much better cleaning experience.<\/p>","sale_badge_3":"","label_3":"Order Steel Brushes","link_3":"shopify:\/\/products\/grillbot-stainless-steel-grill-brushes","image_4":"shopify:\/\/shop_images\/Rectangle_87_3.png","heading_4":"Brush Bundle Set","content_4":"<p>Everyone has a different style of grilling, so why should cleaning be any different? Get all three and SAVE!<\/p>","sale_badge_4":"-10% OFF","label_4":"Order Brush Bundle Set","link_4":"shopify:\/\/products\/grill-brush-bundle-set"}},"0586f681-5b85-418e-90f3-f9511aa72ad8":{"type":"subheading","settings":{"sub_heading":"BROKEN SHAFT REPLACEMENT WITH NEW QUICK RELEASE ADAPTOR"}},"c09f0281-e03c-43e1-b010-d5b9d6a0c260":{"type":"content","settings":{"content":"<p><strong>How to replace a broken shaft with new quick release adaptor and c clip!<\/strong><\/p>"}},"09987ca5-97a6-4d3e-b71b-a88574b24fff":{"type":"steps","settings":{"step_image_1":"shopify:\/\/shop_images\/Rectangle_108.png","step_heading_1":"Step 1","step_content_1":"<p>Remove brush.<\/p>","step_image_2":"shopify:\/\/shop_images\/Rectangle_108_1.png","step_heading_2":"Step 2","step_content_2":"<p>Remove the \"c-clip\" from the brush shaft, then pull off the broken shaft.<\/p>","step_image_3":"shopify:\/\/shop_images\/Rectangle_108_2.png","step_heading_3":"Step 3","step_content_3":"<p>Insert new shaft and secure withc-clip.<\/p>","step_image_4":"shopify:\/\/shop_images\/Rectangle_108_3.png","step_heading_4":"Step 4","step_content_4":"<p>Confirm that the new c-clip is inserted all the way through the pinhole.<\/p>","step_heading_5":"","step_content_5":"","step_heading_6":"","step_content_6":"","step_heading_7":"","step_content_7":"","step_heading_8":"","step_content_8":"","step_heading_9":"","step_content_9":"","step_heading_10":"","step_content_10":""}},"edc48763-65c6-4bb9-83e3-b2b93c304c84":{"type":"subheading","settings":{"sub_heading":"New Quick Release Brush Adapter"}},"e5b0698d-a52b-4214-8f40-11544b03c982":{"type":"image_with_list","settings":{"show_image":true,"right_image":"shopify:\/\/shop_images\/Group_397_1.png","show_points":true,"list_item_1":"New & improved spring action for easy removal of brushes","list_item_2":"Includes 3 Grillbot shaft pieces and 3 claw pins","list_item_3":"No tools required, brushes can be changed in seconds","list_item_4":"Fits all Grillbot models","list_item_5":""}},"e07cec6c-ad5d-45fd-8475-d1c1d57c9ebf":{"type":"content","settings":{"content":"<p>The brushes are built for durability and that sometimes can cause them to be very difficult to remove the first few times.<\/p><p>Try this:<\/p><p>Use a flathead screwdriver or standard pair of pliers. Place the screwdriver between the base of the brush and the base of the Grillbot. Then use force pushing against the base of the Grillbot and the brushes will pop off. You may have to do this 2-3 times before the button will work.  (See image below)!<\/p>"}},"6315d3c7-5cf8-4a3b-889c-45980aeac5ae":{"type":"image_with_list","settings":{"show_image":true,"right_image":"shopify:\/\/shop_images\/brush_large_646f43e8-2939-4c39-96c8-bcfb5cad0920.jpg","show_points":false,"list_item_1":"","list_item_2":"","list_item_3":"","list_item_4":"","list_item_5":""}},"6d5c7e9e-5268-42eb-8e78-1de0850f8b21":{"type":"content","settings":{"content":"<p><strong>Buy New Quick Release Brush Adapter<\/strong><\/p>"}},"7b0a98cd-6dce-4d0a-9f98-398e0755be3c":{"type":"product_list","settings":{"product_1":"grillbot-quick-release-brush-adapter","product_2":"","product_3":"","product_4":"","product_5":""}}},"block_order":["f72daf60-fb85-4a7a-abbc-60d48e79bda9","02702b0b-4ee5-490f-8ce3-9aecc489140c","986200a6-8f16-4783-9351-29f93ea5e03e","c684e8ce-db84-4b22-a66b-f244952c465b","a01727f9-80af-4a66-ad0d-80ef91a64505","ff3a0fa3-a588-4f74-ba75-ecdc50a72da3","1faf2058-75ca-443d-b334-dc4651bbec1e","cb01b762-e150-4085-8b81-3d8a353a8042","0586f681-5b85-418e-90f3-f9511aa72ad8","c09f0281-e03c-43e1-b010-d5b9d6a0c260","09987ca5-97a6-4d3e-b71b-a88574b24fff","edc48763-65c6-4bb9-83e3-b2b93c304c84","e5b0698d-a52b-4214-8f40-11544b03c982","e07cec6c-ad5d-45fd-8475-d1c1d57c9ebf","6315d3c7-5cf8-4a3b-889c-45980aeac5ae","6d5c7e9e-5268-42eb-8e78-1de0850f8b21","7b0a98cd-6dce-4d0a-9f98-398e0755be3c"],"custom_css":[".product-guide-tutorials {width: 70%; left: 30%; position: relative;}"],"settings":{"identifier":"Brushes","background_type":"boxed","heading_alignment":"left","out_spacing":false,"padding_top":20,"padding_bottom":20,"bg_color_all":"#ffffff","text_color":"#1c1c1c","custom_class":"guidence-page sticky-top-section","enable_left_sticks":true,"left_sticks":"shopify:\/\/shop_images\/Group_90.png","enable_right_sticks":true,"right_sticks":"shopify:\/\/shop_images\/Group_89.png"}},"7050b936-340c-48d7-b7a9-64effdd0d498":{"type":"product-guide-tutorials","blocks":{"5a2cbba2-5d36-4473-b87f-8d62ba7245ab":{"type":"heading","settings":{"heading":"Motor"}},"09e0cab8-eece-42b0-acfa-ac5f09f9662d":{"type":"subheading","settings":{"sub_heading":"How To Replace A Broken Motor"}},"0312dc07-5f7e-4dbd-86b0-4c8541e2125c":{"type":"steps","settings":{"step_image_1":"shopify:\/\/shop_images\/Rectangle_108_8.png","step_heading_1":"Step 1","step_content_1":"<p>On a flat surface, flip <br\/>Grillbot over<\/p>","step_image_2":"shopify:\/\/shop_images\/Rectangle_108_9.png","step_heading_2":"Step 2","step_content_2":"<p>Remove the three brushes and quick release adaptors<\/p>","step_image_3":"shopify:\/\/shop_images\/Rectangle_108_11.png","step_heading_3":"Step 3","step_content_3":"<p>Using a 3mm allen key, remove the six screws and carefully separate the two halves<\/p>","step_image_4":"shopify:\/\/shop_images\/Rectangle_108_10.png","step_heading_4":"Step 4","step_content_4":"<p>Make sure to identify the broken motor and using a small Phillips screwdriver, remove the two screws to the broken motor.<\/p>","step_image_5":"shopify:\/\/shop_images\/Rectangle_108_12.png","step_heading_5":"Step 5","step_content_5":"<p>Carefully unplug the broken motor from the PCB board and insert the new motor by \"gently\" plugging back into the PCB board. It will only fit one way, DO NOT FORCE!<\/p>","step_image_6":"shopify:\/\/shop_images\/Rectangle_108_10.png","step_heading_6":"Step 6","step_content_6":"<p>Reattach the motor using the two small Phillips screws<\/p>","step_image_7":"shopify:\/\/shop_images\/Rectangle_108_11.png","step_heading_7":"Step 7","step_content_7":"<p>Carefully align the two main body halves and insert the 6 3mm allen screws<br\/>Now enjoy hands free grilling!<\/p>","step_heading_8":"","step_content_8":"","step_heading_9":"","step_content_9":"","step_heading_10":"","step_content_10":""}},"c8edd6c6-bf46-48c4-9566-c21fb98182e9":{"type":"content","settings":{"content":"<p><strong>Buy New Replacement Motor<\/strong><\/p>"}},"6b33c91b-c34e-46e0-b212-15106d33326e":{"type":"product_list","settings":{"product_1":"new-plug-in-replaceable-motor","product_2":"","product_3":"","product_4":"","product_5":""}}},"block_order":["5a2cbba2-5d36-4473-b87f-8d62ba7245ab","09e0cab8-eece-42b0-acfa-ac5f09f9662d","0312dc07-5f7e-4dbd-86b0-4c8541e2125c","c8edd6c6-bf46-48c4-9566-c21fb98182e9","6b33c91b-c34e-46e0-b212-15106d33326e"],"custom_css":[".product-guide-tutorials {width: 70%; left: 30%; position: relative;}"],"settings":{"identifier":"Motor","background_type":"boxed","heading_alignment":"left","out_spacing":false,"padding_top":20,"padding_bottom":20,"bg_color_all":"#ffffff","text_color":"#1c1c1c","custom_class":"guidence-page","enable_left_sticks":true,"left_sticks":"shopify:\/\/shop_images\/Group_90.png","enable_right_sticks":true,"right_sticks":"shopify:\/\/shop_images\/Group_89.png"}},"a4cec5dc-788c-469f-92bc-dd47af40160d":{"type":"product-guide-tutorials","blocks":{"0d0be485-2bea-4e71-983e-9391692f14d1":{"type":"heading","settings":{"heading":"Battery"}},"6b446216-860a-452f-b306-e76ab730271c":{"type":"subheading","settings":{"sub_heading":"HOW TO REVIVE A SLEEPING BATTERY"}},"1eed04b2-c820-4032-a065-1473f36d5539":{"type":"steps","settings":{"step_image_1":"shopify:\/\/shop_images\/Rectangle_108_4.png","step_heading_1":"Step 1","step_content_1":"<p>Use a 3mm Allen Key to remove the top screw.<\/p>","step_image_2":"shopify:\/\/shop_images\/Rectangle_108_5.png","step_heading_2":"Step 2","step_content_2":"<p>Carefully remove the lid. Locate the battery and wire connectors.<\/p>","step_image_3":"shopify:\/\/shop_images\/Rectangle_108_6.png","step_heading_3":"Step 3","step_content_3":"<p>Identify the color of the battery's connector.<\/p>","step_image_4":"shopify:\/\/shop_images\/Rectangle_108_7.png","step_heading_4":"Step 4","step_content_4":"<p>Unplug the battery, wait 60 seconds, and plug it back in again. <\/p>","step_heading_5":"","step_content_5":"","step_heading_6":"","step_content_6":"","step_heading_7":"","step_content_7":"","step_heading_8":"","step_content_8":"","step_heading_9":"","step_content_9":"","step_heading_10":"","step_content_10":""}},"60335e63-82ed-46d3-ae7d-1bf02a8303d5":{"type":"subheading","settings":{"sub_heading":"REPLACING THE BATTERY"}},"d053b7f1-e798-4bac-b01b-3da5d6181e4e":{"type":"content","settings":{"content":"<p><strong>Dead battery? Here’s how to replace it. <\/strong><\/p>"}},"21bc5dc4-df5d-4be9-91c7-7ca1334df65c":{"type":"steps","settings":{"step_image_1":"shopify:\/\/shop_images\/Rectangle_108_13.png","step_heading_1":"Step 1","step_content_1":"<p>Use a 3mm Allen Key to carefully remove the top cover.<\/p>","step_image_2":"shopify:\/\/shop_images\/Rectangle_108_14.png","step_heading_2":"Step 2","step_content_2":"<p>Locate the battery and wire connectors.<\/p>","step_image_3":"shopify:\/\/shop_images\/Rectangle_108_16.png","step_heading_3":"Step 3","step_content_3":"<p>Disconnect the wire connector by squeezing, then pulling apart two tabs.<\/p>","step_image_4":"shopify:\/\/shop_images\/Rectangle_108_15.png","step_heading_4":"Step 4","step_content_4":"<p>Order the new replacement battery, see below. <\/p>","step_heading_5":"","step_content_5":"","step_heading_6":"","step_content_6":"","step_heading_7":"","step_content_7":"","step_heading_8":"","step_content_8":"","step_heading_9":"","step_content_9":"","step_heading_10":"","step_content_10":""}},"b92c0773-3ed3-49ae-8795-78f4b8d95e08":{"type":"content","settings":{"content":"<p><strong>Buy Lithium Rechargeable Battery<\/strong><\/p>"}},"eb97b480-fb33-4fcd-bc96-f22790b43784":{"type":"product_list","settings":{"product_1":"battery","product_2":"","product_3":"","product_4":"","product_5":""}}},"block_order":["0d0be485-2bea-4e71-983e-9391692f14d1","6b446216-860a-452f-b306-e76ab730271c","1eed04b2-c820-4032-a065-1473f36d5539","60335e63-82ed-46d3-ae7d-1bf02a8303d5","d053b7f1-e798-4bac-b01b-3da5d6181e4e","21bc5dc4-df5d-4be9-91c7-7ca1334df65c","b92c0773-3ed3-49ae-8795-78f4b8d95e08","eb97b480-fb33-4fcd-bc96-f22790b43784"],"custom_css":[".product-guide-tutorials {width: 70%; left: 30%; position: relative;}"],"settings":{"identifier":"Battery","background_type":"boxed","heading_alignment":"left","out_spacing":false,"padding_top":20,"padding_bottom":20,"bg_color_all":"#ffffff","text_color":"#1c1c1c","custom_class":"guidence-page","enable_left_sticks":true,"left_sticks":"shopify:\/\/shop_images\/Group_90.png","enable_right_sticks":true,"right_sticks":"shopify:\/\/shop_images\/Group_89.png"}},"ad6070e8-17bd-4286-91aa-477f9bcbf05d":{"type":"product-guide-tutorials","blocks":{"25b94fe5-06dd-4f65-9637-c290a3759435":{"type":"heading","settings":{"heading":"Safety Tips"}},"4814e89b-8553-4d3d-992d-b890eb989c1b":{"type":"content","settings":{"content":"<p><strong>When operating the Grillbot, make sure the grill is turned off, there is no direct flame and the lid is closed. 🔥<\/strong><br\/>Before first use, charge (about four hours). Don’t worry, Grillbot’s built-in sensor will prevent overcharging.<br\/>Make sure grill is on a flat, even surface for best results.<br\/>Grillbot’s replaceable brushes are available on our website.<br\/>Brushes are easily removed and are dishwasher safe.<br\/>Grillbot’s brass brushes are specifically designed to help protect the coating on your grill grates while also maintaining flavor. Grillbot loves to scrub — use it as often as you like. (Older grills may require a second push of the button). For a more robust clean, try our stainless steel brushes recommend for non-coated grill grates.<br\/>Press button once and Grillbot cleans your grill in minutes. There is a 5-second delay to allow placement on grill. Grillbot beeps when done, or turn Grillbot off by lifting off grill and pressing button until you hear a beep (about 3 seconds).<br\/>Grillbot works on hot or cold grills up to 200 degrees — just remember no flames! Grillbot’s built in alarm will sound if you forget! For charcoal grills, wait until grill cools below 200 degrees.<br\/>Always close lid when not watching Grillbot.<br\/>To clean, remove brushes and wipe bottom with a damp cloth or degreaser. Brushes are dishwasher safe.<br\/>IT'S TIME TO GRILLBOT!<\/p>"}},"17fef4a7-ac7a-4410-a5e1-f5d7f80f4182":{"type":"video","settings":{"video_type":"youtube","video":"","iframe":"https:\/\/www.youtube.com\/embed\/BGFmOJ_7oBo","youtube_height":800}}},"block_order":["25b94fe5-06dd-4f65-9637-c290a3759435","4814e89b-8553-4d3d-992d-b890eb989c1b","17fef4a7-ac7a-4410-a5e1-f5d7f80f4182"],"custom_css":[".product-guide-tutorials {width: 70%; left: 30%; position: relative;}"],"settings":{"identifier":"Safety Tips","background_type":"boxed","heading_alignment":"left","out_spacing":false,"padding_top":20,"padding_bottom":20,"bg_color_all":"#ffffff","text_color":"#1c1c1c","custom_class":"guidence-page","enable_left_sticks":true,"left_sticks":"shopify:\/\/shop_images\/Group_90.png","enable_right_sticks":true,"right_sticks":"shopify:\/\/shop_images\/Group_89.png"}},"6433d5fc-c409-4600-8f92-fd532e293b5c":{"type":"faq","blocks":{"template--14600374321215__6433d5fc-c409-4600-8f92-fd532e293b5c-1683092852907446d6-1":{"type":"question","settings":{"title":"Will a grillbot make my old used barbecue grill look like new?","answer":"<p>Yes, we ship all over the world. Shipping costs will apply, and will be added at checkout. We run discounts and promotions all year, so stay tuned for exclusive deals.<\/p>"}},"template--14600374321215__6433d5fc-c409-4600-8f92-fd532e293b5c-1683092852907446d6-2":{"type":"question","settings":{"title":"How long will it take to get my order?","answer":"<p>It depends on where you are. Orders processed here will take 5-7 business days to arrive. Overseas deliveries can take anywhere from 7-16 days. Delivery details will be provided in your confirmation email.<\/p>"}},"template--14600374321215__6433d5fc-c409-4600-8f92-fd532e293b5c-1683092852907446d6-4":{"type":"question","settings":{"title":"Any question?","answer":"<p>You can contact us through our contact page! We will be happy to assist you.<\/p>"}},"3f2a1f44-cbbb-435d-b088-6a659d265da9":{"type":