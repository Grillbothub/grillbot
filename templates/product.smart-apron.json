iews_bGFUaR":{"type":"reviews","settings":{"review_image":"shopify:\/\/shop_images\/attachment_1.png","name":"Farrah Kaye.","heading":"Smart idea, actually useful.","content":"This isn’t gimmicky. I use it every cookout."}},"reviews_fPJrxz":{"type":"reviews","settings":{"name":"Jared F., Tech guy","heading":"Cleanup is easy.","content":"I wash the apron like normal and I’m done."}}},"block_order":["reviews_hxN6tA","reviews_fNCwUf","reviews_bqhjNB","reviews_iVhYxw","reviews_gkx9RQ","reviews_WCFrgE","reviews_Tyzqb4","reviews_bGFUaR","reviews_fPJrxz"],"name":"Masonary Blocks","settings":{"css_class":"grillbot-product","heading":"What Grillers\u2028<br><span>Are Saying<\/span>","sub_heading":"Let Our Customers<span> Speak For Us<\/span>","subheading":"","total_review_image":"shopify:\/\/shop_images\/Frame_63.png"}},"1762453270c4e6d542":{"type":"apps","blocks":{"loox_reviews_loox_dynamic_section_zk6nnx":{"type":"shopify:\/\/apps\/loox-reviews\/blocks\/loox-dynamic-section\/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e","disabled":true,"settings":{"reviews_to_display":"","default_tab":"automatic","only_photos":false,"aggregated":false,"limit":20,"hide_thumbnails":false,"maxwidth":1080,"is_sample":false}}},"block_order":["loox_reviews_loox_dynamic_section_zk6nnx"],"settings":{"include_horizontal_margins":true,"include_vertical_margins":true}},"custom_faq_whYU3p":{"type":"custom-faq","blocks":{"question_H48kBG":{"type":"question","settings":{"title":"Will this Smart Apron actually make my grilling better?","answer":"<p><strong>Yes <\/strong>- instantly. No more overcooked steaks, flashlight fumbling, or running back inside for tools. This apron handles light, temp, tunes, and tools — so you can handle the grill like a pro.<\/p>"}},"question_bW6yHj":{"type":"question","settings":{"title":"How long does the battery last?","answer":"<p><strong>8–10 hours per charge.<\/strong><\/p><p>That’s multiple full cookouts with music, temp tracking, and light — all on one charge.<br\/><\/p><p>Recharge it via USB between uses. The thermometer charges inside the speaker, no extra cords needed.<br\/><br\/><\/p>"}},"question_bEea3J":{"type":"question","settings":{"title":"Is the Smart Apron Durable Enough?","answer":"<p>Spilled sauce? Smeared rub? No problem.<br\/><\/p><p>Pop out the Bluetooth speaker unit, toss the apron in the wash, and you’re done.<br\/><\/p><p>Built to handle real grill mess — not just look good for photos.<\/p>"}},"question_nTjqkY":{"type":"question","settings":{"title":"Will it fit me?","answer":"<p><strong>Yes. One size fits most.<\/strong><br\/><\/p><p>It’s adjustable to fit a wide range of body types — from backyard dads to pro pitmasters.<br\/><\/p><p>Neck and waist straps lock it in for serious cooking.<\/p>"}},"question_CJAtU8":{"type":"question","settings":{"title":"Why would I use this thermometer instead of my old one?","answer":"<p>Because your old one doesn’t <strong>charge in your apron<\/strong>, auto-connect to your app, or tell your phone exactly when to flip.<br\/>No more hovering. No more poking.<\/p><p><strong>Just perfection — hands-free.<\/strong><\/p>"}},"question_zWc8q4":{"type":"question","settings":{"title":"Is the light actually bright enough for night grilling?","answer":"<p>Absolutely.<\/p><p>The<strong>motion-activated LED<\/strong>lights up your entire grill surface and<strong>tilts to aim exactly where you need it<\/strong>.<\/p><p><br\/>Say goodbye to awkward flashlight balancing.<\/p>"}}},"block_order":["question_H48kBG","question_bW6yHj","question_bEea3J","question_nTjqkY","question_CJAtU8","question_zWc8q4"],"name":"Custom Faq","settings":{"css_class":"home-faq-section","show_navigation":false,"title":"Got Questions?","content":"<p>We've Got <\/p><p><strong>Answers.<\/strong><\/p>","image":"shopify:\/\/shop_images\/1_ef03309f-c796-4654-8d3d-5a634325499b.png","button_text":"","button_url":"shopify:\/\/pages\/grillbot-faq","text_alignment":"left","content_width":"small","background":"rgba(0,0,0,0)","text_co