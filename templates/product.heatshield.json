    "custom_faq_whYU3p": {
      "type": "custom-faq",
      "blocks": {
        "question_H48kBG": {
          "type": "question",
          "settings": {
            "title": "How does the Fliptray help prevent food contamination?",
            "answer": "<p><strong>Fliptray keeps raw and cooked foods 100% separated so you grill safely with<br/>confidence.</strong></p><p>Each side is clearly labeled RAW and COOKED, giving you peace of mind and<br/>eliminating the guesswork that often leads to cross-contamination.</p><p><em>No more wondering which tray touched raw chicken, Flip, prep, and serve without<br/>mixing juices.</em></p>"
          }
        },
        "question_bW6yHj": {
          "type": "question",
          "settings": {
            "title": "Can I really prep, grill, and serve using just one tray?",
            "answer": "<p><strong>Yes! Fliptray is a full-service grilling system in one simple design.</strong></p><p>Prep your food on the RAW side, use the built-in stainless tools while grilling, then flip to the COOKED side to serve.</p><p>You’ll save time, reduce dishes, and enjoy a smoother grilling experience from start to<br/>finish.</p>"
          }
        },
        "question_bEea3J": {
          "type": "question",
          "settings": {
            "title": "What grilling tools are included, and where do they go?",
            "answer": "<p><strong>No more scrambling mid-burger flip.</strong></p><p>Fliptray stores 4 stainless steel tools inside the handles:</p><ul><li>Spatula</li><li>Fork</li><li>Tongs</li><li>Basting Brush</li></ul><p>Your essentials are always right where you need them.</p>"
          }
        },
        "question_nTjqkY": {
          "type": "question",
          "settings": {
            "title": "What makes the FlipTray special?",
            "answer": "<p><strong>Very. Fliptray was built to minimize mess and maximize convenience.</strong></p><ul><li>A deep juice well collects meat drippings</li><li>A silicone drain plug makes cleanup quick</li><li>All parts are dishwasher safe</li></ul><p><em>No more greasy pileups or extra cleanup time, it’s all streamlined.</em></p>"
          }
        },
        "question_CJAtU8": {
          "type": "question",
          "settings": {
            "title": "Does it come with the tools?",
            "answer": "<p><strong>Absolutely. Fliptray is large, tough, and food-safe.</strong></p><ul><li>Measures 17\" x 12\", perfect for big cuts or multiple servings</li><li>Made from BPA-free, ultra-durable plastic</li><li>Doubles as a cutting board for slicing, carving, and plating</li></ul><p><em>Whether you're cooking for a couple or a crowd, Fliptray handles it with style and strength.</em></p>"
          }
        }
      },
